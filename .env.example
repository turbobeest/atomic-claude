# Atomic Claude 2.0 - Environment Configuration Example
# Copy this file to .env and configure for your environment

# =============================================================================
# LLM PROVIDER CONFIGURATION
# =============================================================================

# Option 1: Anthropic API (Direct)
# ANTHROPIC_API_KEY=your-api-key-here

# Option 2: AWS Bedrock (Recommended for GovCloud/Enterprise)
# AWS_PROFILE=your-aws-profile
# AWS_REGION=us-gov-west-1
# CLAUDE_CODE_USE_BEDROCK=1
# ANTHROPIC_MODEL=us-gov.anthropic.claude-sonnet-4-5-20250929-v1:0

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# Network mode: cui (restricted) or open (standard)
ATOMIC_NETWORK_MODE=open

# =============================================================================
# PROJECT SETTINGS
# =============================================================================

# Project name (used in state tracking and outputs)
# ATOMIC_PROJECT_NAME=my-project

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Tool Development Mode
# Set to "true" when developing atomic-claude2 itself (disables forcing function)
# Set to "false" or unset when using atomic-claude2 to build projects
ATOMIC_TOOL_DEVELOPMENT=false

# =============================================================================
# OPTIONAL: MODEL OVERRIDES
# =============================================================================

# Override specific model roles (optional)
# PRIMARY_MODEL=claude-sonnet-4.5
# FAST_MODEL=claude-haiku-3.5
# REASONING_MODEL=claude-opus-4

# =============================================================================
# OPTIONAL: LOGGING
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# Enable verbose output
# VERBOSE=false

# =============================================================================
# KNOWLEDGE GRAPH (FalkorDB) — REQUIRED
# =============================================================================

# FalkorDB knowledge graph is required. Start with: docker compose up -d falkordb
ATOMIC_GRAPH_HOST=localhost
ATOMIC_GRAPH_PORT=6380
# ATOMIC_GRAPH_BROWSER_PORT=3001
# ATOMIC_GRAPH_NAME=atomic-claude
