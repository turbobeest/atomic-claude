// Atomic Claude 2.0 — Task Execution Lifecycle (As-Is)
// What happens when a single task runs inside an orchestrator
//
// Generated: 2026-02-15
// Source: phases/phaseNN/orchestratorNN.py (common pattern)

digraph task_lifecycle {
    rankdir=TB
    fontname="Helvetica"
    fontsize=14
    label="Task Execution Lifecycle (As-Is)\nWhat happens for each task inside an orchestrator"
    labelloc=t
    labeljust=l
    pad=0.5
    nodesep=0.4
    ranksep=0.5

    node [fontname="Helvetica", fontsize=10, style=filled, shape=box]
    edge [fontname="Helvetica", fontsize=9]

    // =============================================
    // ORCHESTRATOR LOOP START
    // =============================================

    start [label="Orchestrator Loop\nfor task_id, task_name, task_func in tasks:",
           fillcolor="#E8E8E8", shape=box]

    // Step 1: Check if already complete
    check_complete [label="state.is_task_complete(phase_id, task_id)?",
                    shape=diamond, fillcolor="#FFFACD", width=3]

    start -> check_complete

    skip [label="SKIP\n(already done)", fillcolor="#D3D3D3"]
    check_complete -> skip [label="Yes\n(resume support)"]
    skip -> start [label="next task", style=dashed]

    // Step 2: Directory validation
    validate [label="validate_directory_pristine()\npre_task_validation.py\n\nScans for project artifacts\nin atomic-claude/ directory",
              fillcolor="#FFB6B6"]

    check_complete -> validate [label="No"]

    validation_fail [label="STOP PHASE\nReturn False\n(user must fix)", fillcolor="#FF6B6B", fontcolor=white]
    validate -> validation_fail [label="violations found\n(BLOCKER)", color="#CC0000", penwidth=2]

    // Step 3: Agent roster
    roster [label="resolve_agent_roster()\ntask_display.py\n\nDiscover agents from\nselected-agents.json\nResolve models via resolver",
            fillcolor="#C8F0C8"]

    validate -> roster [label="clean"]

    // Step 4: Display roster with override
    display [label="display_task_roster()\n\nShow agent/provider/model table\nOffter interactive override\n(change tier, provider, effort)",
             fillcolor="#C8F0C8"]

    roster -> display

    // Step 5: Dashboard sync
    dash_write [label="write_current_task()\n\nWrite .state/current-task.json\n{ task_id, model, provider,\n  agent_roster }",
                fillcolor="#87CEEB"]

    display -> dash_write

    // Step 6: Mark started
    mark_start [label="state.mark_task_started()\n\nUpdate task-state.json:\ntask status = 'in_progress'\nstarted_at = now()",
                fillcolor="#FFB6C1"]

    dash_write -> mark_start

    // Step 7: Create TaskMemory
    create_mem [label="mem = TaskMemory(phase_id, task_id, task_name)\n\nEmpty collector for\ndecisions/findings/configs/\nconversations/warnings",
                fillcolor="#DDA0DD"]

    mark_start -> create_mem

    // Step 8: EXECUTE TASK
    execute [label="success = task_func(mem)\n\nCalls task_NNN.execute(\n  atomic_root, output_dir,\n  uat_mode, mem=mem\n)\n\nTask may:\n- Prompt user for input\n- Make LLM calls\n- Write artifacts to .outputs/\n- Record mem.finding(), mem.decision()",
             fillcolor="#98FB98", style="filled,bold", shape=box]

    create_mem -> execute

    // Step 9: Check result
    check_result [label="success?", shape=diamond, fillcolor="#FFFACD", width=1.5]
    execute -> check_result

    // =============================================
    // FAILURE PATH
    // =============================================

    fail_mark [label="state.mark_task_failed()\nlog_error() to .logs/errors.json",
               fillcolor="#FF6B6B", fontcolor=white]
    fail_return [label="STOP PHASE\nReturn False",
                 fillcolor="#FF6B6B", fontcolor=white]

    check_result -> fail_mark [label="False", color="#CC0000", penwidth=2]
    fail_mark -> fail_return [color="#CC0000"]

    // =============================================
    // SUCCESS PATH
    // =============================================

    // Step 10: Mark complete
    mark_complete [label="state.mark_task_complete()\n\nUpdate task-state.json:\ntask status = 'completed'\ncompleted_at = now()\nartifacts = [file list]",
                   fillcolor="#FFB6C1"]

    check_result -> mark_complete [label="True"]

    // Step 11: Memory save
    mem_check [label="mem.has_entries()?", shape=diamond, fillcolor="#DDA0DD", width=2]
    mark_complete -> mem_check

    mem_rich [label="content = mem.build_content()\nmetadata = mem.build_metadata()\n\nCategorized, substantive entry:\n'Task 002 (Provider detection)...\nFindings:\n- Detected 3 providers\nDecisions:\n- Primary: claude-code'",
              fillcolor="#DDA0DD"]

    mem_fallback [label="content = summarize_task_artifacts()\n\nGeneric summary from JSON files:\n'Task 002 completed.\nProviders: claude-code, anthropic'\n\n(memory_enrichment.py fallback)",
                  fillcolor="#E8E0F3"]

    mem_check -> mem_rich [label="Yes\n(enriched path)"]
    mem_check -> mem_fallback [label="No\n(fallback path)"]

    mem_save [label="memory_save(\n  phase, task_id,\n  content, tags,\n  entry_type=TASK_END,\n  metadata\n)\n\nWrites to:\n  .state/memory.json\n  .state/memory/phase-N/task_NNN.md",
             fillcolor="#DDA0DD"]

    mem_rich -> mem_save
    mem_fallback -> mem_save

    // Step 12: Clear overrides
    clear [label="clear_task_overrides()\nReset task-scoped model selections",
           fillcolor="#D3D3D3"]

    mem_save -> clear

    // Step 13: Next task
    clear -> start [label="next task", style=dashed]

    // =============================================
    // PHASE COMPLETION (after all tasks)
    // =============================================

    phase_done [label="All tasks complete", shape=ellipse, fillcolor="#E8E8E8"]

    phase_cleanup [label="clear_current_task()\nmemory_save(PHASE_CLOSEOUT)\ncreate_closeout()\n→ .outputs/N-phase/closeout.json",
                   fillcolor="#90EE90"]

    phase_return [label="Return True\n→ pipeline handles transition",
                  fillcolor="#90EE90", shape=ellipse]

    start -> phase_done [label="no more tasks", style=dashed]
    phase_done -> phase_cleanup
    phase_cleanup -> phase_return
}
