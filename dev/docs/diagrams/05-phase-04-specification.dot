// Phase 4: Specification — Task Flow
// OpenSpec generation + TDD subtask injection
// Generated: 2026-03-01 from codebase analysis

digraph phase_04_specification {
    rankdir=TB
    fontname="Helvetica"
    fontsize=14
    label="Phase 4: Specification — OpenSpec + TDD Injection"
    labelloc=t
    pad=0.5
    nodesep=0.5
    ranksep=0.7

    node [fontname="Helvetica", fontsize=10, style=filled, shape=box]
    edge [fontname="Helvetica", fontsize=9]

    // Input
    node [shape=note, fillcolor="#FFFACD"]
    tasks_in [label=".taskmaster/tasks/tasks.json\n(from Phase 3)"]

    // Tasks
    t401 [label="Task 401\nEntry & Initialization\n─────────────\nValidate Phase 3 closeout\nInitialize .openspec/", fillcolor="#ADD8E6"]
    t402 [label="Task 402\nAgent Selection\n─────────────\nspecification-agent\ntdd-implementation-agent\n+ pattern-based extras", fillcolor="#ADD8E6"]
    t403 [label="Task 403\nOpenSpec Generation\n─────────────\nParallel LLM (5 workers)\nOne spec per task\nTest strategy, interfaces,\nedge cases, security", fillcolor="#ADD8E6"]
    t404 [label="Task 404\nTDD Subtask Injection\n─────────────\nPer-task LLM enrichment\n(5 concurrent workers)\nInject RED→GREEN→\nREFACTOR→VERIFY", fillcolor="#ADD8E6"]
    t405 [label="Task 405\nPhase Audit", fillcolor="#E8E8E8"]
    t406 [label="Task 406\nCloseout", fillcolor="#E8E8E8"]

    tasks_in -> t401
    t401 -> t402 -> t403 -> t404 -> t405 -> t406

    // LLM
    node [shape=oval, fillcolor="#98FB98"]
    llm1 [label="opus\n5 concurrent\nspec generation"]
    llm2 [label="opus\n5 concurrent\nTDD enrichment"]
    llm1 -> t403 [style=dashed, color="#228B22"]
    llm2 -> t404 [style=dashed, color="#228B22"]

    // Outputs
    node [shape=note, fillcolor="#FFFACD"]
    o_specs [label=".openspec/spec-t*.json\n─────────────\ntest_strategy:\n  unit_tests, integration_tests\n  scenarios (Gherkin)\ninterfaces:\n  inputs, outputs, errors\nedge_cases\nsecurity_requirements"]

    o_tasks [label=".taskmaster/tasks/tasks.json\n(updated with subtasks)\n─────────────\nEach task now has:\n  RED: write failing tests\n  GREEN: minimal impl\n  REFACTOR: lint + clean\n  VERIFY: security scan"]

    t403 -> o_specs [style=dashed, color="#4169E1"]
    t404 -> o_tasks [style=dashed, color="#4169E1"]

    // Cross-task data flow
    o_specs -> t404 [style=dotted, color="#666666", label="spec context\nper task"]

    // Knowledge graph
    node [shape=cylinder, fillcolor="#DDA0DD"]
    kg [label="Knowledge Graph\nspec nodes"]
    t403 -> kg [style=dashed, color="#8B008B"]

    // TDD chain detail
    subgraph cluster_tdd {
        label="TDD Subtask Chain (per task)"
        style=dashed
        color="#CC6600"

        red [label="RED\nWrite failing tests\ndeps: []", shape=box, fillcolor="#FFB6C1"]
        green [label="GREEN\nMinimal implementation\ndeps: [RED]", shape=box, fillcolor="#90EE90"]
        refactor [label="REFACTOR\nLint + clean up\ndeps: [GREEN]", shape=box, fillcolor="#ADD8E6"]
        verify [label="VERIFY\nSecurity scan\ndeps: [REFACTOR]", shape=box, fillcolor="#DDA0DD"]

        red -> green -> refactor -> verify
    }

    // Next phase
    node [shape=box, fillcolor="#B3D9FF", style="filled,bold"]
    next [label="→ Phase 5: Implementation"]
    t406 -> next
}
