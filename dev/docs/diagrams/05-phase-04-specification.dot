// Phase 4: Specification — Task Flow
// Generated: 2026-03-01 from codebase analysis

digraph phase_04_specification {
    rankdir=TB
    fontname="Helvetica"
    fontsize=16
    label="Phase 4: Specification \u2014 OpenSpec + TDD Injection"
    labelloc=t
    labeljust=c
    pad=0.3
    nodesep=0.35
    ranksep=0.45
    splines=true
    bgcolor=white

    node [fontname="Helvetica", fontsize=10, style="filled,rounded", shape=box, margin="0.12,0.06"]
    edge [fontname="Helvetica", fontsize=8, arrowsize=0.7]

    // ── Input ──
    node [shape=note, fillcolor="#FFFACD", fontsize=8]
    tasks_in [label=".taskmaster/tasks/tasks.json\n(from Phase 3)"]

    // ── Task spine ──
    node [shape=box]
    t401 [label="401  Entry & Init\nValidate Phase 3 closeout, init .openspec/", fillcolor="#ADD8E6"]
    t402 [label="402  Agent Selection\nspecification-agent, tdd-implementation-agent", fillcolor="#ADD8E6"]
    t403 [label="403  OpenSpec Generation  [opus \u00d7 5]\nOne spec per task: test strategy,\ninterfaces, edge cases, security", fillcolor="#ADD8E6"]
    t404 [label="404  TDD Subtask Injection  [opus \u00d7 5]\nEnrich each task with\nRED \u2192 GREEN \u2192 REFACTOR \u2192 VERIFY", fillcolor="#ADD8E6"]
    t405 [label="405  Phase Audit", fillcolor="#E8E8E8"]
    t406 [label="406  Closeout", fillcolor="#E8E8E8"]
    next [label="Phase 5: Implementation  \u2192", fillcolor="#B3D9FF", style="filled,rounded,bold"]

    tasks_in -> t401 -> t402 -> t403 -> t404 -> t405 -> t406 -> next

    // ── Spec feeds TDD injection ──
    node [shape=note, fillcolor="#FFFACD", fontsize=8, margin="0.08,0.04"]
    o_specs [label=".openspec/spec-t*.json\ntest_strategy, interfaces,\nedge_cases, security_reqs"]
    o_tasks [label="tasks.json (updated)\nEach task now has:\nRED / GREEN / REFACTOR / VERIFY"]

    t403 -> o_specs [style=dashed, color="#4169E1", arrowsize=0.5]
    o_specs -> t404 [style=dotted, color="#666666", arrowsize=0.5, label="spec context"]
    t404 -> o_tasks [style=dashed, color="#4169E1", arrowsize=0.5]

    {rank=same; t403; o_specs}
    {rank=same; t404; o_tasks}

    // ── Knowledge Graph ──
    node [shape=cylinder, fillcolor="#E8D5F5", fontsize=8]
    kg [label="Knowledge Graph\nspec nodes"]
    t403 -> kg [style=dashed, color="#8B008B", arrowsize=0.5]

    // ── TDD chain visual ──
    subgraph cluster_tdd {
        label="TDD Subtask Chain (injected per task)"
        labeljust=c
        fontsize=9
        style="dashed,rounded"
        color="#CC6600"
        margin=8

        node [fontsize=9, margin="0.08,0.04"]
        red [label="RED\nfailing tests", fillcolor="#FFB6C1"]
        green [label="GREEN\nminimal impl", fillcolor="#90EE90"]
        refactor [label="REFACTOR\nlint + clean", fillcolor="#ADD8E6"]
        verify [label="VERIFY\nsecurity scan", fillcolor="#DDA0DD"]

        red -> green -> refactor -> verify [arrowsize=0.5]
    }

    t404 -> red [style=dotted, color="#CC6600", arrowsize=0.5]
}
