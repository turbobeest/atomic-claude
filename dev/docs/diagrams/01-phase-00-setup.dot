// Phase 0: Setup — Task Flow
// Environment detection, provider config, wizard, material scan, system setup
// Generated: 2026-03-01 from codebase analysis

digraph phase_00_setup {
    rankdir=TB
    fontname="Helvetica"
    fontsize=14
    label="Phase 0: Setup — Task Flow & Data Dependencies"
    labelloc=t
    pad=0.5
    nodesep=0.5
    ranksep=0.7

    node [fontname="Helvetica", fontsize=10, style=filled, shape=box]
    edge [fontname="Helvetica", fontsize=9]

    // Tasks
    t001 [label="Task 001\nEnvironment Bootstrap\n─────────────\nDetect OS, verify 8 required\n+ 5 recommended tools\nLaunch dashboard + FalkorDB", fillcolor="#90EE90"]
    t002 [label="Task 002\nProvider Detection\n─────────────\nLoad credentials from .env\nHealth-check providers\nBuild provider inventory", fillcolor="#90EE90"]
    t003 [label="Task 003\nSetup Wizard\n─────────────\n10-step interactive config:\nname, type, mode, repo,\nLLM, agents, audit, sandbox", fillcolor="#90EE90"]
    t004 [label="Task 004\nMaterial Scan\n─────────────\nScan project for 40+ file types\nCollect external references\nOrganize into docs/reference/", fillcolor="#90EE90"]
    t005 [label="Task 005\nRepository & System Setup\n─────────────\nVerify agents/audits/skills\nConfigure task routing\nAssess CPU/GPU/memory/network", fillcolor="#90EE90"]
    closeout [label="Closeout\n─────────────\nGenerate closeout.json\nApproval gate", fillcolor="#E8E8E8"]

    t001 -> t002 -> t003 -> t004 -> t005 -> closeout

    // Outputs
    node [shape=note, fillcolor="#FFFACD"]
    o_config [label="project-config.json\n(full project config)"]
    o_provider [label="provider-inventory.json\nsecrets.json"]
    o_manifest [label="material-manifest.json"]
    o_env [label="env-validation.json"]

    t001 -> o_config [style=dashed, color="#4169E1", label="environment section"]
    t002 -> o_provider [style=dashed, color="#4169E1"]
    t003 -> o_config [style=dashed, color="#4169E1", label="merged config"]
    t004 -> o_manifest [style=dashed, color="#4169E1"]
    t005 -> o_env [style=dashed, color="#4169E1"]

    // Output directory
    node [shape=folder, fillcolor="#E0E0FF"]
    outdir [label=".outputs/0-setup/"]
    o_config -> outdir [style=dotted]
    o_provider -> outdir [style=dotted]
    o_manifest -> outdir [style=dotted]
    o_env -> outdir [style=dotted]

    // LLM usage
    node [shape=oval, fillcolor="#98FB98"]
    llm1 [label="haiku\n(AI suggestions\nfrom reference\nmaterials)"]
    llm1 -> t003 [style=dashed, color="#228B22", label="optional"]

    // Human interaction
    node [shape=octagon, fillcolor="#FFD700"]
    h001 [label="Human:\ninstall missing\ntools"]
    h002 [label="Human:\ncredential\nwizard"]
    h003 [label="Human:\n10-step\nwizard"]
    h004 [label="Human:\norganize\nmaterials?"]

    h001 -> t001 [style=dashed, color="#CC0000"]
    h002 -> t002 [style=dashed, color="#CC0000"]
    h003 -> t003 [style=dashed, color="#CC0000"]
    h004 -> t004 [style=dashed, color="#CC0000"]

    // Phase output
    node [shape=box, fillcolor="#B3D9FF", style="filled,bold"]
    next [label="→ Phase 1: Discovery"]
    closeout -> next
}
