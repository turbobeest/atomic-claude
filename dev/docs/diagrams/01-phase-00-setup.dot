// Phase 0: Setup — Task Flow
// Generated: 2026-03-01 from codebase analysis

digraph phase_00_setup {
    rankdir=TB
    fontname="Helvetica"
    fontsize=16
    label="Phase 0: Setup"
    labelloc=t
    labeljust=c
    pad=0.3
    nodesep=0.35
    ranksep=0.45
    splines=true
    bgcolor=white

    node [fontname="Helvetica", fontsize=10, style="filled,rounded", shape=box, margin="0.12,0.06"]
    edge [fontname="Helvetica", fontsize=8, arrowsize=0.7]

    // ── Task spine ──
    t001 [label="001  Environment Bootstrap\nDetect OS, verify tools, launch services", fillcolor="#90EE90"]
    t002 [label="002  Provider Detection\nLoad .env credentials, health-check LLMs", fillcolor="#90EE90"]
    t003 [label="003  Setup Wizard\n10-step interactive config", fillcolor="#90EE90"]
    t004 [label="004  Material Scan\nScan 40+ file types, organize references", fillcolor="#90EE90"]
    t005 [label="005  Repository & System Setup\nVerify agents/audits, assess resources", fillcolor="#90EE90"]
    closeout [label="Closeout + Approval", fillcolor="#E8E8E8"]
    next [label="Phase 1: Discovery  \u2192", fillcolor="#B3D9FF", style="filled,rounded,bold"]

    t001 -> t002 -> t003 -> t004 -> t005 -> closeout -> next

    // ── Human interaction (inline diamonds) ──
    node [shape=diamond, fillcolor="#FFD700", fontsize=8, width=0.2, height=0.2, margin="0.08,0.04"]

    h001 [label="install\nmissing tools"]
    h002 [label="credential\nwizard"]
    h003 [label="10-step\nwizard"]
    h004 [label="organize\nmaterials?"]

    h001 -> t001 [style=dashed, color="#CC0000", arrowsize=0.5]
    h002 -> t002 [style=dashed, color="#CC0000", arrowsize=0.5]
    h003 -> t003 [style=dashed, color="#CC0000", arrowsize=0.5]
    h004 -> t004 [style=dashed, color="#CC0000", arrowsize=0.5]

    // ── LLM usage ──
    node [shape=oval, fillcolor="#C6E2FF", fontsize=8, width=0.1]
    llm [label="haiku\n(optional AI suggestions)"]
    llm -> t003 [style=dashed, color="#228B22", arrowsize=0.5]

    // ── Outputs (compact) ──
    node [shape=note, fillcolor="#FFFACD", fontsize=8, margin="0.08,0.04"]
    outputs [label=".outputs/0-setup/\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nproject-config.json\nprovider-inventory.json\nmaterial-manifest.json\nenv-validation.json"]

    t005 -> outputs [style=dashed, color="#4169E1", arrowsize=0.5]

    // ── Keep outputs right of spine ──
    {rank=same; t005; outputs}
    {rank=same; t001; h001}
    {rank=same; t002; h002}
    {rank=same; t003; h003; llm}
    {rank=same; t004; h004}
}
