// Core Systems — Architecture Overview
// Generated: 2026-03-01 from codebase analysis

digraph core_systems {
    rankdir=TB
    fontname="Helvetica"
    fontsize=16
    label="Core Systems \u2014 Architecture & Data Flow"
    labelloc=t
    labeljust=c
    pad=0.3
    nodesep=0.4
    ranksep=0.5
    splines=true
    bgcolor=white
    compound=true

    node [fontname="Helvetica", fontsize=10, style="filled,rounded", shape=box, margin="0.12,0.06"]
    edge [fontname="Helvetica", fontsize=8, arrowsize=0.7]

    // ── Pipeline (top) ──
    subgraph cluster_pipeline {
        label="Pipeline Orchestrator"
        labeljust=c
        fontsize=11
        style="filled,rounded"
        color="#4169E1"
        fillcolor="#E8F4FD"
        margin=10

        node [fillcolor="#C6E2FF"]
        registry [label="Phase Registry\n0-9: Setup \u2192 Release"]
        lifecycle [label="Lifecycle: NOT_STARTED \u2192\nINITIALIZING \u2192 READY \u2192\nRUNNING \u2192 COMPLETED"]
        transition [label="Transition Mode\nAUTO | PROMPT | MANUAL"]

        registry -> lifecycle -> transition [style=invis]
    }

    // ── State Manager ──
    subgraph cluster_state {
        label="StateManager  core/state.py"
        labeljust=c
        fontsize=10
        style="filled,rounded"
        color="#CC0066"
        fillcolor="#FFF0F5"
        margin=10

        node [fillcolor="#FFB6C1"]
        state_ops [label="mark_task_started / complete / failed\nget_completed_tasks, is_task_complete"]
        state_lock [label="StateLock\nfcntl (Unix) | msvcrt (Windows)"]
        state_snap [label="Snapshot / Restore\natomic JSON writes (temp + rename)"]

        state_ops -> state_lock [style=invis]
        state_lock -> state_snap [style=invis]
    }

    // ── Memory System ──
    subgraph cluster_memory {
        label="Memory System  core/memory/"
        labeljust=c
        fontsize=10
        style="filled,rounded"
        color="#228B22"
        fillcolor="#F0FFF0"
        margin=10

        node [fillcolor="#90EE90"]
        mem_store [label="MemoryStore\nappend-only JSON, dual-write to graph"]
        mem_checkpoint [label="CheckpointManager\nper-phase, prunes to last 10"]
        mem_compact [label="Compactor\nage prune \u2192 dedup (Jaccard) \u2192 score"]
        mem_recall [label="Recall\ngraph fulltext \u2192 file-based fallback\n50% keyword + 30% recency + 20% phase"]

        mem_store -> mem_checkpoint [style=invis]
        mem_checkpoint -> mem_compact [style=invis]
        mem_compact -> mem_recall [style=invis]
    }

    // ── LLM Router ──
    subgraph cluster_llm {
        label="LLM Router  core/llm/"
        labeljust=c
        fontsize=10
        style="filled,rounded"
        color="#CC6600"
        fillcolor="#FFFFF0"
        margin=10

        node [fillcolor="#FFE4B5"]
        resolver [label="ModelResolver (5-level)\nexplicit \u2192 user \u2192 agent \u2192 phase \u2192 default"]
        router_node [label="Router\nfallback chains, circuit breaker\n(3 fails \u2192 5min cooldown), cache (15min)"]
        provider_chain [label="Claude Code CLI \u2192 Anthropic API\n\u2192 AWS Bedrock \u2192 Ollama"]

        resolver -> router_node -> provider_chain
    }

    // ── Knowledge Graph ──
    subgraph cluster_kg {
        label="Knowledge Graph  core/graph/"
        labeljust=c
        fontsize=10
        style="filled,rounded"
        color="#8B008B"
        fillcolor="#F5F0FF"
        margin=10

        node [fillcolor="#E8D5F5"]
        graph_conn [label="FalkorDB (Redis-based)\nsingleton, auto-reconnect, graceful degradation"]
        graph_mgr [label="10 node types: Source, Task, Spec, Feature...\n7 edge types: DERIVED_FROM, IMPLEMENTS..."]

        graph_conn -> graph_mgr
    }

    // ── Audit ──
    subgraph cluster_audit {
        label="Audit  core/audit.py"
        labeljust=c
        fontsize=10
        style="filled,rounded"
        color="#996600"
        fillcolor="#FFF8F0"
        margin=10

        node [fillcolor="#FFE4B5"]
        audit_flow [label="43 categories, parallel eval (5 max)\nremediation loop (3 rounds)\nnon-blocking: always returns True"]
    }

    // ── Dashboard ──
    subgraph cluster_dash {
        label="Dashboard Sync"
        labeljust=c
        fontsize=10
        style="filled,rounded"
        color="#4169E1"
        fillcolor="#F0F0FF"
        margin=10

        node [fillcolor="#C6E2FF"]
        dash_sync [label="current-task.json | session-tokens.json\nerrors.json | task-state.json"]
        dash_ui [label="Dashboard UI  port 5174\nNode.js/Express"]

        dash_sync -> dash_ui
    }

    // ── Pipeline \u2192 systems ──
    registry -> state_ops [label="state transitions", lhead=cluster_state]
    registry -> mem_checkpoint [label="checkpoints", lhead=cluster_memory]
    registry -> router_node [label="model resolution", lhead=cluster_llm, style=dashed]
    registry -> audit_flow [label="phase audits", lhead=cluster_audit]
    registry -> dash_sync [label="task updates", lhead=cluster_dash]

    // ── Memory \u2194 Graph (dual-write) ──
    mem_store -> graph_mgr [label="dual-write", color="#8B008B", style=dashed]
    mem_recall -> graph_conn [label="fulltext search", color="#8B008B", style=dashed]

    // ── State \u2194 Memory ──
    state_snap -> mem_checkpoint [label="snapshot in checkpoint", color="#CC0066", style=dashed]

    // ── Backtrack ──
    node [shape=octagon, fillcolor="#FF6347", fontsize=9]
    backtrack_node [label="Backtrack\ninvalidate checkpoints\nclear memory, reset state\nrestore snapshot"]
    backtrack_node -> state_snap [style=dashed, color="#FF0000", arrowsize=0.5]
    backtrack_node -> mem_checkpoint [style=dashed, color="#FF0000", arrowsize=0.5]
    backtrack_node -> graph_mgr [style=dashed, color="#FF0000", arrowsize=0.5]

    // ── Data files ──
    node [shape=note, fillcolor="#FFFACD", fontsize=8, margin="0.08,0.04"]
    state_file [label=".state/task-state.json"]
    mem_files [label=".state/memory/\nmemory-log.json\ncheckpoints/*.json"]

    state_ops -> state_file [style=dashed, color="#4169E1", arrowsize=0.5]
    mem_store -> mem_files [style=dashed, color="#4169E1", arrowsize=0.5]
}
