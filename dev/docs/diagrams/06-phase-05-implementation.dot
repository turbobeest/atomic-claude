// Phase 5: Implementation — Task Flow
// Generated: 2026-03-01 from codebase analysis

digraph phase_05_implementation {
    rankdir=TB
    fontname="Helvetica"
    fontsize=16
    label="Phase 5: Implementation \u2014 TDD Execution Engine"
    labelloc=t
    labeljust=c
    pad=0.3
    nodesep=0.3
    ranksep=0.4
    splines=true
    bgcolor=white
    compound=true

    node [fontname="Helvetica", fontsize=10, style="filled,rounded", shape=box, margin="0.12,0.06"]
    edge [fontname="Helvetica", fontsize=8, arrowsize=0.7]

    // ── Pre-execution tasks ──
    t501 [label="501  Entry & Init\nValidate Phase 4, verify TDD subtasks", fillcolor="#FFFACD"]
    t502 [label="502  TDD Setup\nDetect stack, coverage targets", fillcolor="#FFFACD"]
    t503 [label="503  Agent Selection\nRED: test-strategist  GREEN: tdd-impl\nREFACTOR: code-review  VERIFY: guardian", fillcolor="#FFFACD"]

    t501 -> t502 -> t503

    // ── DAG execution ──
    subgraph cluster_exec {
        label="Task 504: TDD Execution  [opus per task]"
        labeljust=c
        fontsize=10
        style="filled,rounded"
        color="#CC6600"
        fillcolor="#FFFFF0"
        margin=10

        pilot [label="Pilot Batch\n2-3 root tasks\nvalidate approach", fillcolor="#FFE4B5"]
        dag [label="DAG Wave Execution\nparallel within waves\nsequential across", fillcolor="#FFE4B5"]

        pilot -> dag [label=">50% pass"]

        subgraph cluster_cycle {
            label="Per-Task TDD Cycle"
            labeljust=c
            fontsize=9
            style="dashed,rounded"
            color="#888888"
            margin=8

            node [fontsize=9, margin="0.08,0.04"]
            red [label="RED\nfailing tests\ngate: compile", fillcolor="#FFB6C1"]
            green [label="GREEN\nminimal impl\ngate: tests pass\n(3 retries)", fillcolor="#90EE90"]
            refactor [label="REFACTOR\nlint + clean\ngate: lint clean", fillcolor="#ADD8E6"]
            verify [label="VERIFY\nsecurity scan\ngate: no critical", fillcolor="#DDA0DD"]

            red -> green -> refactor -> verify [arrowsize=0.5]
        }

        dag -> red

        budget [label="Token\nBudget", shape=diamond, fillcolor="#FFD700", fontsize=8, width=0.8, height=0.5]
        dag -> budget [style=dashed, arrowsize=0.5]
    }

    // ── Post-execution ──
    t505 [label="505  Validation\nAggregate results, run suite, coverage", fillcolor="#FFFACD"]
    t506 [label="506  Phase Audit", fillcolor="#E8E8E8"]
    t507 [label="507  Closeout", fillcolor="#E8E8E8"]
    next [label="Phase 6: Code Review  \u2192", fillcolor="#B3D9FF", style="filled,rounded,bold"]

    t503 -> pilot
    verify -> t505 [ltail=cluster_exec]
    t505 -> t506 -> t507 -> next

    // ── Human gates ──
    node [shape=diamond, fillcolor="#FFD700", fontsize=8, margin="0.08,0.04"]
    h_pilot [label="pilot\napproval"]
    h_impl [label="HUMAN GATE\nImpl Review"]
    h_pilot -> pilot [style=dashed, color="#CC0000", arrowsize=0.5]
    h_impl -> t507 [style=dashed, color="#CC0000", arrowsize=0.5]
    {rank=same; t507; h_impl}

    // ── Source Registry ──
    node [shape=component, fillcolor="#E0FFE0", fontsize=8]
    registry [label="ProjectSourceRegistry\nthread-safe, tracks files\npasses deps downstream"]
    green -> registry [style=dashed, color="#666666", arrowsize=0.5]
    registry -> red [style=dashed, color="#666666", arrowsize=0.5, label="dep code"]

    // ── Inputs ──
    node [shape=note, fillcolor="#FFFACD", fontsize=8]
    i_tasks [label="tasks.json\n(with TDD subtasks)"]
    i_specs [label=".openspec/spec-t*.json"]
    i_tasks -> t501 [style=dotted, color="#666666", arrowsize=0.5]
    i_specs -> red [style=dotted, color="#666666", arrowsize=0.5, label="test strategy"]

    // ── Outputs ──
    node [shape=note, fillcolor="#FFFACD", fontsize=8, margin="0.08,0.04"]
    o_progress [label=".claude/testing/\ntdd-progress.json\nper-task records"]
    o_validation [label="validation-report.json\ncoverage %, security"]

    verify -> o_progress [style=dashed, color="#4169E1", arrowsize=0.5]
    t505 -> o_validation [style=dashed, color="#4169E1", arrowsize=0.5]
    {rank=same; t505; o_validation}

    // ── Stack profiles ──
    node [shape=tab, fillcolor="#F0F0F0", fontsize=8]
    stacks [label="Python: pytest  |  Rust: cargo\nNode: jest  |  Go: go test"]
    stacks -> t502 [style=dotted, color="#666666", arrowsize=0.5]
    {rank=same; t502; stacks}
}
