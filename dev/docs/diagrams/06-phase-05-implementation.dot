// Phase 5: Implementation — Task Flow
// Stack-aware parallel TDD execution with DAG-ordered waves
// Generated: 2026-03-01 from codebase analysis

digraph phase_05_implementation {
    rankdir=TB
    fontname="Helvetica"
    fontsize=14
    label="Phase 5: Implementation — TDD Execution Engine"
    labelloc=t
    pad=0.5
    nodesep=0.5
    ranksep=0.6

    node [fontname="Helvetica", fontsize=10, style=filled, shape=box]
    edge [fontname="Helvetica", fontsize=9]

    // Tasks
    t501 [label="Task 501\nEntry & Initialization\n─────────────\nValidate Phase 4 closeout\nVerify TDD subtasks exist\nInit .claude/testing/", fillcolor="#FFFACD"]
    t502 [label="Task 502\nTDD Setup\n─────────────\nDetect tech stack:\nfilesystem → PRD → spec → user\nCoverage targets, test pyramid", fillcolor="#FFFACD"]
    t503 [label="Task 503\nAgent Selection\n─────────────\nRED: test-strategist\nGREEN: tdd-implementation\nREFACTOR: code-review-gate\nVERIFY: plan-guardian", fillcolor="#FFFACD"]

    // Execution cluster
    subgraph cluster_exec {
        label="Task 504: TDD Execution (DAG-ordered waves)"
        style=filled
        fillcolor="#FFFFF0"
        color="#CC6600"

        pilot [label="Pilot Batch\n2-3 root tasks\nValidate approach", shape=box, fillcolor="#FFE4B5"]
        dag [label="DAG Wave Execution\nParallel within waves\nSequential across waves", shape=box, fillcolor="#FFE4B5"]
        pilot -> dag [label=">50% pass"]

        subgraph cluster_cycle {
            label="Per-Task TDD Cycle"
            style=dashed
            color="#666666"

            red [label="RED\nGenerate failing tests\nGate: compile check", fillcolor="#FFB6C1"]
            green [label="GREEN\nMinimal implementation\nGate: tests pass\n(max 3 retries)", fillcolor="#90EE90"]
            refactor [label="REFACTOR\nLint + clean up\nGate: lint clean", fillcolor="#ADD8E6"]
            verify [label="VERIFY\nSecurity scan\nGate: no critical issues", fillcolor="#DDA0DD"]
            red -> green -> refactor -> verify
        }

        dag -> red

        budget [label="Token Budget\nTracking\n(pause if exceeded)", shape=diamond, fillcolor="#FFD700"]
        dag -> budget [style=dashed]
    }

    t505 [label="Task 505\nValidation\n─────────────\nAggregate TDD records\nRun test suite\nMeasure coverage\nSecurity summary", fillcolor="#FFFACD"]
    t506 [label="Task 506\nPhase Audit", fillcolor="#E8E8E8"]
    t507 [label="Task 507\nCloseout", fillcolor="#E8E8E8"]

    t501 -> t502 -> t503 -> pilot
    verify -> t505 [ltail=cluster_exec]
    t505 -> t506 -> t507

    // Inputs
    node [shape=note, fillcolor="#FFFACD"]
    i_tasks [label=".taskmaster/tasks/tasks.json\n(with TDD subtasks)"]
    i_specs [label=".openspec/spec-t*.json"]
    i_tasks -> t501 [style=dotted, color="#666666"]
    i_specs -> red [style=dotted, color="#666666", label="test strategy"]

    // LLM
    node [shape=oval, fillcolor="#98FB98"]
    llm [label="opus\nRED, GREEN,\nREFACTOR, VERIFY\n(per task)"]
    llm -> red [style=dashed, color="#228B22"]

    // Source registry
    node [shape=component, fillcolor="#E0FFE0"]
    registry [label="ProjectSourceRegistry\n(thread-safe)\nTracks generated files\nPasses dependency code\nto downstream tasks"]
    green -> registry [style=dashed, color="#666666"]
    registry -> red [style=dashed, color="#666666", label="dep code"]

    // Outputs
    node [shape=note, fillcolor="#FFFACD"]
    o_progress [label=".claude/testing/\ntdd-progress.json\ntdd-t*.json\n─────────────\nPer-task: status,\ntest files, impl files,\nattempts, duration"]
    o_validation [label="validation-report.json\n─────────────\ncompletion rate\ntdd cycles\ntest results\ncoverage %\nsecurity issues"]

    verify -> o_progress [style=dashed, color="#4169E1"]
    t505 -> o_validation [style=dashed, color="#4169E1"]

    // Stack profiles
    node [shape=tab, fillcolor="#F0F0F0"]
    stacks [label="Stack Profiles\n─────────────\nPython: pytest, py_compile\nRust: cargo test, clippy, audit\nNode: jest, eslint, npm audit\nGo: go test, go vet"]
    stacks -> t502 [style=dotted, color="#666666"]

    // Human
    node [shape=octagon, fillcolor="#FFD700"]
    h_pilot [label="Human:\npilot approval"]
    h_budget [label="Human:\nbudget confirm"]
    h_gate [label="HUMAN GATE\nImpl Review"]
    h_pilot -> pilot [style=dashed, color="#CC0000"]
    h_budget -> budget [style=dashed, color="#CC0000"]
    h_gate -> t507 [style=dashed, color="#CC0000"]

    // Next
    node [shape=box, fillcolor="#B3D9FF", style="filled,bold"]
    next [label="→ Phase 6: Code Review"]
    t507 -> next
}
