// Phase 9: Release — Task Flow
// Generated: 2026-03-01 from codebase analysis

digraph phase_09_release {
    rankdir=TB
    fontname="Helvetica"
    fontsize=16
    label="Phase 9: Release \u2014 Execution & Announcement"
    labelloc=t
    labeljust=c
    pad=0.3
    nodesep=0.35
    ranksep=0.45
    splines=true
    bgcolor=white

    node [fontname="Helvetica", fontsize=10, style="filled,rounded", shape=box, margin="0.12,0.06"]
    edge [fontname="Helvetica", fontsize=8, arrowsize=0.7]

    // ── Task spine ──
    t901 [label="901  Entry & Init\nValidate Phase 8 closeout", fillcolor="#FFFACD"]
    t902 [label="902  Release Setup\nFinal confirm, review notes", fillcolor="#FFFACD"]
    t903 [label="903  Agent Selection\nannouncement-writer", fillcolor="#FFFACD"]

    t901 -> t902 -> t903

    // ── Execution ──
    subgraph cluster_exec {
        label="Task 904: Release Execution  [haiku]"
        labeljust=c
        fontsize=10
        style="filled,rounded"
        color="#228B22"
        fillcolor="#F0FFF0"
        margin=10

        node [fontsize=9]
        ctx [label="Gather Context\nPRD + changelog +\nphase 5-8 summaries\n(8000 char limit)", fillcolor="#90EE90"]
        announce [label="Generate Announcement\nannouncement.md", fillcolor="#90EE90"]
        record [label="Execution Record", fillcolor="#90EE90"]

        ctx -> announce -> record

        fallback [label="fallback: hardcoded template", shape=plaintext, fontsize=7, fillcolor="#F0FFF0"]
    }

    // ── Post-execution ──
    t905 [label="905  Release Confirmation\nconfirm / rollback / investigate", fillcolor="#FFD700", style="filled,rounded,bold"]
    t906 [label="906  Final Closeout", fillcolor="#98FB98", style="filled,rounded,bold"]
    done [label="PROJECT COMPLETE", shape=doublecircle, fillcolor="#98FB98", fontsize=9, width=0.9]

    t903 -> ctx [lhead=cluster_exec]
    record -> t905 -> t906 -> done

    // ── Human gates ──
    node [shape=diamond, fillcolor="#FFD700", fontsize=8, margin="0.08,0.04"]
    h_setup [label="confirm /\nreview / abort"]
    h_release [label="HUMAN GATE\nRelease Confirm"]
    h_setup -> t902 [style=dashed, color="#CC0000", arrowsize=0.5]
    h_release -> t905 [style=dashed, color="#CC0000", arrowsize=0.5]
    {rank=same; t902; h_setup}
    {rank=same; t905; h_release}

    // ── Inputs ──
    node [shape=note, fillcolor="#FFFACD", fontsize=8]
    i_deploy [label=".claude/deployment/\nsetup.json, artifacts.json"]
    i_deploy -> t902 [style=dotted, color="#666666", arrowsize=0.5]

    // ── Outputs ──
    node [shape=note, fillcolor="#FFFACD", fontsize=8, margin="0.08,0.04"]
    o_announce [label=".claude/release/announcement.md"]
    o_confirm [label=".claude/release/confirmation.json"]
    o_decisions [label=".outputs/9-release/*-decision.json"]

    announce -> o_announce [style=dashed, color="#4169E1", arrowsize=0.5]
    t905 -> o_confirm [style=dashed, color="#4169E1", arrowsize=0.5]
    t906 -> o_decisions [style=dashed, color="#4169E1", arrowsize=0.5]
}
