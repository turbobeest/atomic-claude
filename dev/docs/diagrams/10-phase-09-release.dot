// Phase 9: Release — Task Flow
// Internal release execution, announcement generation, project completion
// Generated: 2026-03-01 from codebase analysis

digraph phase_09_release {
    rankdir=TB
    fontname="Helvetica"
    fontsize=14
    label="Phase 9: Release — Execution & Announcement"
    labelloc=t
    pad=0.5
    nodesep=0.5
    ranksep=0.7

    node [fontname="Helvetica", fontsize=10, style=filled, shape=box]
    edge [fontname="Helvetica", fontsize=9]

    // Tasks
    t901 [label="Task 901\nEntry & Initialization\n─────────────\nValidate Phase 8 closeout\nPresent objectives", fillcolor="#ADD8E6"]
    t902 [label="Task 902\nRelease Setup\n─────────────\nFinal confirmation\nReview release notes\n(confirm / review / abort)", fillcolor="#ADD8E6"]
    t903 [label="Task 903\nAgent Selection\n─────────────\nannouncement-writer\n(1 agent)", fillcolor="#ADD8E6"]

    // Execution cluster
    subgraph cluster_exec {
        label="Task 904: Release Execution"
        style=filled
        fillcolor="#F0FFF0"
        color="#228B22"

        context [label="Gather Context\nPRD + changelog +\nphase 5-8 summaries\n(8000 char limit)", shape=box, fillcolor="#90EE90"]
        announce [label="Generate Announcement\nannouncement.md\n(haiku)", shape=box, fillcolor="#90EE90"]
        record [label="Execution Record\nexecution-decision.json", shape=box, fillcolor="#90EE90"]

        context -> announce -> record
    }

    t905 [label="Task 905\nRelease Confirmation\n─────────────\nHUMAN GATE\nconfirm / rollback /\ninvestigate", fillcolor="#FFD700", style="filled,bold"]
    t906 [label="Task 906\nCloseout\n─────────────\nFinal phase closeout\nPROJECT COMPLETE", fillcolor="#98FB98", style="filled,bold"]

    t901 -> t902 -> t903 -> context [lhead=cluster_exec]
    record -> t905 -> t906

    // Inputs
    node [shape=note, fillcolor="#FFFACD"]
    i_deploy [label=".claude/deployment/\nsetup.json\nartifacts.json"]
    i_prd [label="docs/prd/PRD.md"]
    i_phases [label="Phase 5-8 summaries\n(closeout files)"]
    i_deploy -> t902 [style=dotted, color="#666666"]
    i_prd -> context [style=dotted, color="#666666"]
    i_phases -> context [style=dotted, color="#666666"]

    // LLM
    node [shape=oval, fillcolor="#98FB98"]
    llm [label="haiku\nannouncement writing\n2 retries\nfallback template"]
    llm -> announce [style=dashed, color="#228B22"]

    // Fallback
    node [shape=component, fillcolor="#E0FFE0"]
    fallback [label="Fallback Template\n─────────────\nHardcoded if LLM fails:\nsummary, what's new,\nartifacts, next steps"]
    fallback -> announce [style=dotted, color="#666666"]

    // Outputs
    node [shape=note, fillcolor="#FFFACD"]
    o_announce [label=".claude/release/\nannouncement.md\n─────────────\nRelease summary\nWhat's new\nArtifacts\nNext steps"]
    o_confirm [label=".claude/release/\nconfirmation.json\n─────────────\nRelease confirmed\nVersion, timestamp"]
    o_decisions [label=".outputs/9-release/\n*-decision.json\n─────────────\nentry, setup, agents,\nexecution, confirmation"]

    announce -> o_announce [style=dashed, color="#4169E1"]
    t905 -> o_confirm [style=dashed, color="#4169E1"]
    t901 -> o_decisions [style=dashed, color="#4169E1"]

    // Human gates
    node [shape=octagon, fillcolor="#FFD700"]
    h902 [label="Human:\nrelease confirm\n(confirm/review/abort)"]
    h905 [label="HUMAN GATE\nRelease\nConfirmation"]
    h902 -> t902 [style=dashed, color="#CC0000"]
    h905 -> t905 [style=dashed, color="#CC0000"]

    // Terminal
    node [shape=doublecircle, fillcolor="#98FB98"]
    done [label="PROJECT\nCOMPLETE"]
    t906 -> done
}
