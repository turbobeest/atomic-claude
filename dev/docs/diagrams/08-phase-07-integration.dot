// Phase 7: Integration — Task Flow
// E2E testing, acceptance validation, performance benchmarks
// Generated: 2026-03-01 from codebase analysis

digraph phase_07_integration {
    rankdir=TB
    fontname="Helvetica"
    fontsize=14
    label="Phase 7: Integration — E2E & Acceptance Testing"
    labelloc=t
    pad=0.5
    nodesep=0.5
    ranksep=0.7

    node [fontname="Helvetica", fontsize=10, style=filled, shape=box]
    edge [fontname="Helvetica", fontsize=9]

    // Tasks
    t701 [label="Task 701\nEntry & Initialization\n─────────────\nValidate Phase 6 closeout\nPresent phase objectives", fillcolor="#ADD8E6"]
    t702 [label="Task 702\nIntegration Setup\n─────────────\nConfigure environment\nReview acceptance criteria\nCount test suites", fillcolor="#ADD8E6"]
    t703 [label="Task 703\nAgent Selection\n─────────────\ne2e-test-runner\nacceptance-validator\nperf-tester\nintegration-reporter", fillcolor="#ADD8E6"]

    // Testing cluster
    subgraph cluster_test {
        label="Task 704: Testing Execution"
        style=filled
        fillcolor="#F0FFF0"
        color="#228B22"

        e2e [label="E2E Tests\nFull workflow\nvalidation", shape=box, fillcolor="#90EE90"]
        accept [label="Acceptance Tests\n10 criteria from PRD", shape=box, fillcolor="#90EE90"]
        perf [label="Performance\nBenchmarks\n(3 benchmarks)", shape=box, fillcolor="#90EE90"]

        results [label="Results Aggregation\ntests_run, passed, failed\nper-suite breakdown", shape=box, fillcolor="#FFDAB9"]

        e2e -> results
        accept -> results
        perf -> results
    }

    t705 [label="Task 705\nIntegration Approval\n─────────────\nHUMAN GATE\napprove / investigate /\nfix-and-rerun", fillcolor="#FFD700", style="filled,bold"]
    t706 [label="Task 706\nPhase Audit\n(non-blocking)", fillcolor="#E8E8E8"]
    t707 [label="Task 707\nCloseout", fillcolor="#E8E8E8"]

    t701 -> t702 -> t703 -> e2e [lhead=cluster_test]
    results -> t705 -> t706 -> t707

    // Inputs
    node [shape=note, fillcolor="#FFFACD"]
    i_code [label="Implemented +\nreviewed code\n(Phase 5 + 6)"]
    i_review [label=".claude/reviews/\nfindings.json\nrefinement-report.json"]
    i_code -> e2e [style=dotted, color="#666666"]
    i_review -> e2e [style=dotted, color="#666666"]

    // Stack-specific runners
    node [shape=tab, fillcolor="#F0F0F0"]
    runners [label="Test Runners\n─────────────\nPython: pytest\nRust: cargo test\nNode: jest/vitest\nGo: go test"]
    runners -> e2e [style=dotted, color="#666666"]

    // Outputs
    node [shape=note, fillcolor="#FFFACD"]
    o_setup [label=".outputs/7-integration/\nintegration-setup.json\n─────────────\nenvironment config\nacceptance criteria count"]
    o_results [label=".outputs/7-integration/\nintegration-test-results.json\n─────────────\ntests_run, tests_passed\ntests_failed\nper-suite breakdown"]
    o_approval [label=".claude/integration/\napproval.json\n─────────────\nE2E status\nacceptance status\nsimulated flag"]

    t702 -> o_setup [style=dashed, color="#4169E1"]
    results -> o_results [style=dashed, color="#4169E1"]
    t705 -> o_approval [style=dashed, color="#4169E1"]

    // Human gates
    node [shape=octagon, fillcolor="#FFD700"]
    h701 [label="Human:\nentry confirm"]
    h702 [label="Human:\nenv confirm"]
    h705 [label="HUMAN GATE\nIntegration\nApproval"]
    h701 -> t701 [style=dashed, color="#CC0000"]
    h702 -> t702 [style=dashed, color="#CC0000"]
    h705 -> t705 [style=dashed, color="#CC0000"]

    // Next phase
    node [shape=box, fillcolor="#B3D9FF", style="filled,bold"]
    next [label="→ Phase 8: Deployment Prep"]
    t707 -> next
}
