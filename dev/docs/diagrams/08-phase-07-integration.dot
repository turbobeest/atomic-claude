// Phase 7: Integration — Task Flow
// Generated: 2026-03-01 from codebase analysis

digraph phase_07_integration {
    rankdir=TB
    fontname="Helvetica"
    fontsize=16
    label="Phase 7: Integration \u2014 E2E & Acceptance Testing"
    labelloc=t
    labeljust=c
    pad=0.3
    nodesep=0.35
    ranksep=0.45
    splines=true
    bgcolor=white

    node [fontname="Helvetica", fontsize=10, style="filled,rounded", shape=box, margin="0.12,0.06"]
    edge [fontname="Helvetica", fontsize=8, arrowsize=0.7]

    // ── Task spine ──
    t701 [label="701  Entry & Init\nValidate Phase 6 closeout", fillcolor="#FFFACD"]
    t702 [label="702  Integration Setup\nConfigure environment, acceptance criteria", fillcolor="#FFFACD"]
    t703 [label="703  Agent Selection\ne2e-runner, acceptance-validator,\nperf-tester, reporter", fillcolor="#FFFACD"]

    t701 -> t702 -> t703

    // ── Testing ──
    subgraph cluster_test {
        label="Task 704: Test Execution"
        labeljust=c
        fontsize=10
        style="filled,rounded"
        color="#228B22"
        fillcolor="#F0FFF0"
        margin=10

        node [fontsize=9, margin="0.08,0.04"]
        e2e [label="E2E Tests\nfull workflow", fillcolor="#90EE90"]
        accept [label="Acceptance\n10 PRD criteria", fillcolor="#90EE90"]
        perftest [label="Performance\n3 benchmarks", fillcolor="#90EE90"]

        {rank=same; e2e; accept; perftest}

        results [label="Results Aggregation\ntests_run, passed, failed", fillcolor="#FFDAB9"]
        e2e -> results
        accept -> results
        perftest -> results
    }

    // ── Post-testing ──
    t705 [label="705  Integration Approval\napprove / investigate / fix-and-rerun", fillcolor="#FFD700", style="filled,rounded,bold"]
    t706 [label="706  Phase Audit", fillcolor="#E8E8E8"]
    t707 [label="707  Closeout", fillcolor="#E8E8E8"]
    next [label="Phase 8: Deployment Prep  \u2192", fillcolor="#B3D9FF", style="filled,rounded,bold"]

    t703 -> e2e [lhead=cluster_test]
    results -> t705 -> t706 -> t707 -> next

    // ── Human gate ──
    node [shape=diamond, fillcolor="#FFD700", fontsize=8, margin="0.08,0.04"]
    hgate [label="HUMAN GATE\nIntegration Approval"]
    hgate -> t705 [style=dashed, color="#CC0000", arrowsize=0.5]
    {rank=same; t705; hgate}

    // ── Stack runners ──
    node [shape=tab, fillcolor="#F0F0F0", fontsize=8]
    runners [label="pytest | cargo test | jest | go test"]
    runners -> e2e [style=dotted, color="#666666", arrowsize=0.5]

    // ── Outputs ──
    node [shape=note, fillcolor="#FFFACD", fontsize=8, margin="0.08,0.04"]
    o_results [label=".outputs/7-integration/\nintegration-test-results.json"]
    o_approval [label=".claude/integration/\napproval.json"]

    results -> o_results [style=dashed, color="#4169E1", arrowsize=0.5]
    t705 -> o_approval [style=dashed, color="#4169E1", arrowsize=0.5]
}
