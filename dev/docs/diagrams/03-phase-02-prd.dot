// Phase 2: PRD — Task Flow
// 15-section PRD via 12 LLM generations with guardian validation
// Generated: 2026-03-01 from codebase analysis

digraph phase_02_prd {
    rankdir=TB
    fontname="Helvetica"
    fontsize=14
    label="Phase 2: PRD — 12-Generation Authoring Pipeline"
    labelloc=t
    pad=0.5
    nodesep=0.5
    ranksep=0.6

    node [fontname="Helvetica", fontsize=10, style=filled, shape=box]
    edge [fontname="Helvetica", fontsize=9]

    // Tasks
    t201 [label="Task 201\nEntry Validation\n─────────────\nLoad Phase 1 context:\ncloseout, approach,\ncorpus, dialogue", fillcolor="#ADD8E6"]
    t202 [label="Task 202\nPRD Setup\n─────────────\nScope: full/mvp/component\nFocus: arch, api, data,\nsecurity, performance...", fillcolor="#ADD8E6"]
    t203 [label="Task 203\nInterview (optional)\n─────────────\nStakeholders, success\ncriteria, non-goals,\nMVP scope", fillcolor="#ADD8E6"]
    t204 [label="Task 204\nAgent Selection\n─────────────\nrequirements-engineer\nprd-writer, prd-validator", fillcolor="#ADD8E6"]

    // Generation cluster
    subgraph cluster_gen {
        label="Task 205: PRD Authoring (12 opus generations)"
        style=filled
        fillcolor="#F0F8FF"
        color="#4169E1"

        g01 [label="Gen 1\nVision +\nExec Summary", shape=box, fillcolor="#C6E2FF"]
        g02 [label="Gen 2\nTechnical\nArchitecture", shape=box, fillcolor="#C6E2FF"]
        g03 [label="Gen 3\nFeature\nRequirements", shape=box, fillcolor="#C6E2FF"]
        g04 [label="Gen 4\nNon-Functional\nRequirements", shape=box, fillcolor="#C6E2FF"]
        g05 [label="Gen 5\nDependency\nChain", shape=box, fillcolor="#C6E2FF"]
        g06 [label="Gen 6\nDevelopment\nPhases", shape=box, fillcolor="#C6E2FF"]
        g07 [label="Gen 7\nCode\nStructure", shape=box, fillcolor="#C6E2FF"]
        g08 [label="Gen 8\nTDD\nStrategy", shape=box, fillcolor="#C6E2FF"]
        g09 [label="Gen 9\nIntegration\nTesting", shape=box, fillcolor="#C6E2FF"]
        g10 [label="Gen 10\nDocumentation\nReqs", shape=box, fillcolor="#C6E2FF"]
        g11 [label="Gen 11\nOperational\nReqs", shape=box, fillcolor="#C6E2FF"]
        g12 [label="Gen 12\nRisks +\nMetrics", shape=box, fillcolor="#C6E2FF"]

        g01 -> g02 -> g03 -> g04 -> g05 -> g06
        g06 -> g07 -> g08 -> g09 -> g10 -> g11 -> g12

        // Guardian validation between each
        guard [label="Guardian Validation\nbetween each generation:\nstructure, length, no preamble", shape=diamond, fillcolor="#FFD700", width=1.5]
    }

    // Validation
    subgraph cluster_validate {
        label="Task 206: PRD Validation"
        style=filled
        fillcolor="#FFF8F0"
        color="#CC6600"

        v1 [label="Pass 1: Structural\n≥10 of 15 sections\n≥100 lines", shape=box, fillcolor="#FFE4B5"]
        v2 [label="Pass 2: Content\ncompleteness, testability\nconsistency, compatibility", shape=box, fillcolor="#FFE4B5"]
        v1 -> v2
        rev [label="Task 206b\nRevision\n(max 3 iter)", shape=box, fillcolor="#FFE4B5"]
        v2 -> rev [label="FAIL/WARN", style=dashed]
        rev -> v1 [label="re-validate", style=dashed]
    }

    t207 [label="Task 207\nPRD Approval\n─────────────\nHUMAN GATE", fillcolor="#FFD700", style="filled,bold"]
    t208 [label="Task 208\nPhase Audit", fillcolor="#E8E8E8"]
    t209 [label="Task 209\nCloseout", fillcolor="#E8E8E8"]

    t201 -> t202 -> t203 -> t204 -> g01
    g12 -> v1
    v2 -> t207 [label="PASS"]
    t207 -> t208 -> t209

    // PRD output
    node [shape=note, fillcolor="#FFFACD"]
    prd [label="docs/prd/PRD.md\n(15 sections)"]
    g12 -> prd [style=dashed, color="#4169E1"]

    // LLM
    node [shape=oval, fillcolor="#98FB98"]
    llm_opus [label="opus\n12 generations\nprior content capped\nat 12K chars"]
    llm_sonnet [label="sonnet\nvalidation"]
    llm_opus -> g01 [style=dashed, color="#228B22"]
    llm_sonnet -> v2 [style=dashed, color="#228B22"]

    // Knowledge graph
    node [shape=cylinder, fillcolor="#DDA0DD"]
    kg [label="Knowledge Graph\nFeatures F-1..F-12"]
    g12 -> kg [style=dashed, color="#8B008B"]

    // Human gate
    node [shape=octagon, fillcolor="#FFD700"]
    h207 [label="HUMAN GATE\nPRD Approval"]
    h207 -> t207 [style=dashed, color="#CC0000"]

    // Next phase
    node [shape=box, fillcolor="#B3D9FF", style="filled,bold"]
    next [label="→ Phase 3: Tasking"]
    t209 -> next
}
