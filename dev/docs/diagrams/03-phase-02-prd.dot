// Phase 2: PRD — Task Flow
// Generated: 2026-03-01 from codebase analysis

digraph phase_02_prd {
    rankdir=TB
    fontname="Helvetica"
    fontsize=16
    label="Phase 2: PRD \u2014 12-Generation Authoring Pipeline"
    labelloc=t
    labeljust=c
    pad=0.3
    nodesep=0.3
    ranksep=0.4
    splines=true
    bgcolor=white

    node [fontname="Helvetica", fontsize=10, style="filled,rounded", shape=box, margin="0.12,0.06"]
    edge [fontname="Helvetica", fontsize=8, arrowsize=0.7]

    // ── Pre-authoring tasks ──
    t201 [label="201  Entry Validation\nLoad Phase 1 context", fillcolor="#ADD8E6"]
    t202 [label="202  PRD Setup\nScope: full / mvp / component", fillcolor="#ADD8E6"]
    t203 [label="203  Interview (optional)\nStakeholders, success criteria", fillcolor="#ADD8E6"]
    t204 [label="204  Agent Selection\nrequirements-engineer, prd-writer", fillcolor="#ADD8E6"]

    t201 -> t202 -> t203 -> t204

    // ── 12-generation authoring ──
    subgraph cluster_gen {
        label="Task 205: PRD Authoring  [opus \u00d7 12]"
        labeljust=c
        fontsize=10
        style="filled,rounded"
        color="#4169E1"
        fillcolor="#F0F8FF"
        margin=10

        node [fontsize=9, fillcolor="#C6E2FF"]

        g01 [label="1 Vision"]
        g02 [label="2 Architecture"]
        g03 [label="3 Features"]
        g04 [label="4 NFRs"]
        g05 [label="5 Dependencies"]
        g06 [label="6 Dev Phases"]
        g07 [label="7 Code Structure"]
        g08 [label="8 TDD Strategy"]
        g09 [label="9 Integration"]
        g10 [label="10 Docs"]
        g11 [label="11 Operations"]
        g12 [label="12 Risks"]

        g01 -> g02 -> g03 -> g04 -> g05 -> g06
        g06 -> g07 -> g08 -> g09 -> g10 -> g11 -> g12

        guard [label="Guardian validates\nbetween each gen", shape=diamond, fillcolor="#FFD700", fontsize=8, width=1.2, height=0.5]
    }

    // ── Validation ──
    subgraph cluster_val {
        label="Task 206: Validation  [sonnet]"
        labeljust=c
        fontsize=10
        style="filled,rounded"
        color="#CC6600"
        fillcolor="#FFF8F0"
        margin=10

        node [fontsize=9, fillcolor="#FFE4B5"]

        v1 [label="Structural Check\n\u226510 sections, \u2265100 lines"]
        v2 [label="Content Check\ncompleteness, testability"]
        rev [label="Revision (max 3)"]

        v1 -> v2
        v2 -> rev [label="FAIL", style=dashed, fontsize=7]
        rev -> v1 [label="retry", style=dashed, fontsize=7]
    }

    // ── Post-validation ──
    t207 [label="207  PRD Approval", fillcolor="#FFD700", style="filled,rounded,bold"]
    t208 [label="208  Phase Audit", fillcolor="#E8E8E8"]
    t209 [label="209  Closeout", fillcolor="#E8E8E8"]
    next [label="Phase 3: Tasking  \u2192", fillcolor="#B3D9FF", style="filled,rounded,bold"]

    t204 -> g01
    g12 -> v1
    v2 -> t207 [label="PASS"]
    t207 -> t208 -> t209 -> next

    // ── Human gate ──
    node [shape=diamond, fillcolor="#FFD700", fontsize=8, margin="0.08,0.04"]
    hgate [label="HUMAN GATE\nPRD Approval"]
    hgate -> t207 [style=dashed, color="#CC0000", arrowsize=0.5]
    {rank=same; t207; hgate}

    // ── Knowledge Graph ──
    node [shape=cylinder, fillcolor="#E8D5F5", fontsize=8]
    kg [label="Knowledge Graph\nFeatures F-1..F-12"]
    g12 -> kg [style=dashed, color="#8B008B", arrowsize=0.5]

    // ── Output ──
    node [shape=note, fillcolor="#FFFACD", fontsize=8, margin="0.08,0.04"]
    prd [label="docs/prd/PRD.md\n(15 sections)"]
    g12 -> prd [style=dashed, color="#4169E1", arrowsize=0.5]
    {rank=same; prd; kg}
}
