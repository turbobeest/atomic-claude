// Atomic Claude 2.0 — Pipeline Overview
// 10-phase SDLC pipeline with dependency gates and human checkpoints
// Generated: 2026-03-01 from codebase analysis

digraph pipeline_overview {
    rankdir=TB
    compound=true
    fontname="Helvetica"
    fontsize=14
    label="Atomic Claude 2.0 — Pipeline Overview\n10-Phase SDLC with Dependency Gates"
    labelloc=t
    labeljust=l
    pad=0.5
    nodesep=0.4
    ranksep=0.6

    node [fontname="Helvetica", fontsize=11, style=filled]
    edge [fontname="Helvetica", fontsize=9]

    // Entry point
    entry [label="main.py\n(CLI Entry)", shape=box, fillcolor="#E8E8E8"]

    // Pipeline orchestrator
    pipeline [label="PhasePipeline\norchestration/pipeline.py", shape=box,
              fillcolor="#B3D9FF", style="filled,bold"]

    entry -> pipeline [label="run_phase(N)"]

    // Phases
    subgraph cluster_phases {
        label="Phases"
        style=dashed
        color="#999999"

        p0 [label="Phase 0: Setup\n5 tasks | orchestrator00", shape=box, fillcolor="#90EE90", style="filled,bold"]
        p1 [label="Phase 1: Discovery\n9 tasks | orchestrator01", shape=box, fillcolor="#90EE90"]
        p2 [label="Phase 2: PRD\n10 tasks | orchestrator02", shape=box, fillcolor="#ADD8E6", style="filled,bold"]
        p3 [label="Phase 3: Tasking\n6 tasks | orchestrator03", shape=box, fillcolor="#ADD8E6"]
        p4 [label="Phase 4: Specification\n6 tasks | orchestrator04", shape=box, fillcolor="#ADD8E6"]
        p5 [label="Phase 5: Implementation\n7 tasks | orchestrator05", shape=box, fillcolor="#FFFACD", style="filled,bold"]
        p6 [label="Phase 6: Code Review\n6 tasks | orchestrator06", shape=box, fillcolor="#FFFACD"]
        p7 [label="Phase 7: Integration\n7 tasks | orchestrator07", shape=box, fillcolor="#FFFACD"]
        p8 [label="Phase 8: Deployment Prep\n7 tasks | orchestrator08", shape=box, fillcolor="#FFFACD"]
        p9 [label="Phase 9: Release\n6 tasks | orchestrator09", shape=box, fillcolor="#FFFACD", style="filled,bold"]
    }

    pipeline -> p0 [label="validate deps\nimport orchestrator"]

    p0 -> p1 [label="closeout.json", color="#228B22", penwidth=2]
    p1 -> p2 [label="closeout.json", color="#228B22", penwidth=2]
    p2 -> p3 [label="closeout.json", color="#228B22", penwidth=2]
    p3 -> p4 [label="closeout.json", color="#228B22", penwidth=2]
    p4 -> p5 [label="closeout.json", color="#228B22", penwidth=2]
    p5 -> p6 [label="closeout.json", color="#228B22", penwidth=2]
    p6 -> p7 [label="closeout.json", color="#228B22", penwidth=2]
    p7 -> p8 [label="closeout.json", color="#228B22", penwidth=2]
    p8 -> p9 [label="closeout.json", color="#228B22", penwidth=2]

    // Human gates
    subgraph cluster_gates {
        label="Human Gates\n(forced PROMPT mode)"
        style=dashed
        color="#CC0000"
        fontcolor="#CC0000"

        gate0 [label="Gate 0\nSetup Review", shape=diamond, fillcolor="#FFD700", width=1.2, height=0.8]
        gate2 [label="Gate 2\nPRD Approval", shape=diamond, fillcolor="#FFD700", width=1.2, height=0.8]
        gate5 [label="Gate 5\nImpl Review", shape=diamond, fillcolor="#FFD700", width=1.2, height=0.8]
        gate9 [label="Gate 9\nRelease Sign-off", shape=diamond, fillcolor="#FFD700", width=1.2, height=0.8]
    }

    p0 -> gate0 [style=dashed, color="#CC0000"]
    gate0 -> p1 [style=dashed, color="#CC0000"]
    p2 -> gate2 [style=dashed, color="#CC0000"]
    gate2 -> p3 [style=dashed, color="#CC0000"]
    p5 -> gate5 [style=dashed, color="#CC0000"]
    gate5 -> p6 [style=dashed, color="#CC0000"]
    p9 -> gate9 [style=dashed, color="#CC0000"]

    // Core systems
    subgraph cluster_core {
        label="Core Systems (shared across all phases)"
        style=filled
        color="#F0F0F0"
        fillcolor="#F8F8F8"

        state [label="StateManager\ncore/state.py\n.state/task-state.json", shape=cylinder, fillcolor="#FFB6C1"]
        memory [label="Memory System\ncore/memory/\n.state/memory/", shape=cylinder, fillcolor="#DDA0DD"]
        llm [label="LLM Router\ncore/llm/\nclaude-code → anthropic\n→ bedrock → ollama", shape=box3d, fillcolor="#98FB98"]
        config [label="Config\ncore/config.py\nmodels.json + .env", shape=note, fillcolor="#F0E68C"]
        audit [label="Audit Framework\ncore/audit.py\n43 categories", shape=box3d, fillcolor="#E0E0E0"]
        dashboard [label="Dashboard\nlocalhost:5174\nNode.js/Express", shape=component, fillcolor="#87CEEB"]
        graph [label="Knowledge Graph\nFalkorDB (optional)\nFeatures, Tasks, Specs", shape=cylinder, fillcolor="#DDA0DD"]
    }

    p0 -> state [style=dotted, color="#999999", constraint=false, label="mark_task_*"]
    p0 -> memory [style=dotted, color="#999999", constraint=false, label="memory_save"]
    p0 -> llm [style=dotted, color="#999999", constraint=false, label="invoke_llm"]
    p0 -> dashboard [style=dotted, color="#999999", constraint=false, label="sync_dashboard"]

    // Legend
    subgraph cluster_legend {
        label="Legend"
        style=filled
        fillcolor=white
        color="#CCCCCC"

        node [shape=plaintext, fillcolor=white]

        l1 [label="Green fill = battle-tested (Phase 0-1)"]
        l2 [label="Blue fill = implemented, exercised (Phase 2-4)"]
        l3 [label="Yellow fill = implemented, lightly tested (Phase 5-9)"]
        l4 [label="Bold border = human gate phase"]
        l5 [label="Green arrow = closeout.json dependency"]
        l6 [label="Red dashed = human gate transition"]
    }
}
