// Atomic Claude 2.0 — Pipeline Overview
// 10-phase SDLC pipeline with dependency gates and human checkpoints
// Generated: 2026-03-01 from codebase analysis

digraph pipeline_overview {
    rankdir=TB
    compound=true
    fontname="Helvetica"
    fontsize=16
    label="Atomic Claude 2.0 — Pipeline Overview"
    labelloc=t
    labeljust=c
    pad=0.3
    nodesep=0.3
    ranksep=0.4
    bgcolor=white
    splines=true

    node [fontname="Helvetica", fontsize=10, style=filled, margin="0.15,0.08"]
    edge [fontname="Helvetica", fontsize=8]

    // ── Entry ──
    entry [label="main.py", shape=box, fillcolor="#E8E8E8", style="filled,rounded"]
    pipeline [label="PhasePipeline\norchestration/pipeline.py", shape=box,
              fillcolor="#B3D9FF", style="filled,rounded,bold"]

    entry -> pipeline [label=" run_phase(N) ", arrowsize=0.7]

    // ── Phase chain with inline gates ──
    // Phases are the main vertical spine. Gates sit between gated phases.

    p0  [label="Phase 0: Setup\n5 tasks", shape=box, fillcolor="#90EE90", style="filled,rounded,bold"]
    g0  [label="  Setup Review  ", shape=diamond, fillcolor="#FFD700", fontsize=9, width=1.4, height=0.6]
    p1  [label="Phase 1: Discovery\n9 tasks", shape=box, fillcolor="#90EE90", style="filled,rounded"]
    p2  [label="Phase 2: PRD\n10 tasks", shape=box, fillcolor="#ADD8E6", style="filled,rounded,bold"]
    g2  [label="  PRD Approval  ", shape=diamond, fillcolor="#FFD700", fontsize=9, width=1.4, height=0.6]
    p3  [label="Phase 3: Tasking\n6 tasks", shape=box, fillcolor="#ADD8E6", style="filled,rounded"]
    p4  [label="Phase 4: Specification\n6 tasks", shape=box, fillcolor="#ADD8E6", style="filled,rounded"]
    p5  [label="Phase 5: Implementation\n7 tasks", shape=box, fillcolor="#FFFACD", style="filled,rounded,bold"]
    g5  [label="  Impl Review  ", shape=diamond, fillcolor="#FFD700", fontsize=9, width=1.4, height=0.6]
    p6  [label="Phase 6: Code Review\n6 tasks", shape=box, fillcolor="#FFFACD", style="filled,rounded"]
    p7  [label="Phase 7: Integration\n7 tasks", shape=box, fillcolor="#FFFACD", style="filled,rounded"]
    p8  [label="Phase 8: Deployment Prep\n7 tasks", shape=box, fillcolor="#FFFACD", style="filled,rounded"]
    p9  [label="Phase 9: Release\n6 tasks", shape=box, fillcolor="#FFFACD", style="filled,rounded,bold"]
    g9  [label="  Release Sign-off  ", shape=diamond, fillcolor="#FFD700", fontsize=9, width=1.4, height=0.6]
    done [label="PROJECT\nCOMPLETE", shape=doublecircle, fillcolor="#98FB98", fontsize=9, width=0.8]

    // Main chain
    pipeline -> p0 [arrowsize=0.7]
    p0 -> g0 [color="#CC0000", style=dashed, arrowsize=0.6]
    g0 -> p1 [color="#CC0000", style=dashed, arrowsize=0.6]
    p1 -> p2 [color="#228B22", arrowsize=0.6]
    p2 -> g2 [color="#CC0000", style=dashed, arrowsize=0.6]
    g2 -> p3 [color="#CC0000", style=dashed, arrowsize=0.6]
    p3 -> p4 [color="#228B22", arrowsize=0.6]
    p4 -> p5 [color="#228B22", arrowsize=0.6]
    p5 -> g5 [color="#CC0000", style=dashed, arrowsize=0.6]
    g5 -> p6 [color="#CC0000", style=dashed, arrowsize=0.6]
    p6 -> p7 [color="#228B22", arrowsize=0.6]
    p7 -> p8 [color="#228B22", arrowsize=0.6]
    p8 -> p9 [color="#228B22", arrowsize=0.6]
    p9 -> g9 [color="#CC0000", style=dashed, arrowsize=0.6]
    g9 -> done [color="#CC0000", style=dashed, arrowsize=0.6]

    // ── Core Systems (right column) ──
    subgraph cluster_core {
        label="Core Systems"
        labeljust=c
        fontsize=11
        style="filled,rounded"
        color="#CCCCCC"
        fillcolor="#F8F8F8"
        margin=12

        state     [label="StateManager\ncore/state.py", shape=box, fillcolor="#FFB6C1", style="filled,rounded"]
        memory    [label="Memory\ncore/memory/", shape=box, fillcolor="#DDA0DD", style="filled,rounded"]
        llm       [label="LLM Router\ncore/llm/", shape=box, fillcolor="#98FB98", style="filled,rounded"]
        kgraph    [label="Knowledge Graph\nFalkorDB", shape=box, fillcolor="#DDA0DD", style="filled,rounded"]
        audit     [label="Audit\n43 categories", shape=box, fillcolor="#E0E0E0", style="filled,rounded"]
        dashboard [label="Dashboard\nport 5174", shape=box, fillcolor="#87CEEB", style="filled,rounded"]

        state -> memory -> llm -> kgraph -> audit -> dashboard [style=invis]
    }

    // Connect pipeline to core systems (single edge)
    pipeline -> state [label=" shared by\n all phases ", style=dotted, color="#999999",
                       arrowsize=0.6, lhead=cluster_core, minlen=2]

    // ── LLM Provider chain ──
    subgraph cluster_providers {
        label="LLM Providers (fallback order)"
        labeljust=c
        fontsize=10
        style="filled,rounded"
        color="#CCCCCC"
        fillcolor="#F8F8F8"
        margin=12

        node [shape=box, fontsize=9, style="filled,rounded"]
        cc  [label="Claude Code\nCLI", fillcolor="#C6E2FF"]
        api [label="Anthropic\nAPI", fillcolor="#C6E2FF"]
        bed [label="AWS\nBedrock", fillcolor="#C6E2FF"]
        oll [label="Ollama\n(local)", fillcolor="#C6E2FF"]

        cc -> api -> bed -> oll [arrowsize=0.5, label=" ", color="#999999"]
    }

    llm -> cc [style=dotted, color="#999999", arrowsize=0.5, lhead=cluster_providers]

    // ── Legend ──
    subgraph cluster_legend {
        label=""
        style="filled,rounded"
        fillcolor="#FAFAFA"
        color="#DDDDDD"
        margin=8

        node [shape=plaintext, fillcolor="#FAFAFA", fontsize=9]

        legend [label=<
            <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="2">
                <TR>
                    <TD BGCOLOR="#90EE90"> &nbsp; </TD><TD ALIGN="LEFT">Battle-tested (Phase 0-1)</TD>
                    <TD>&nbsp;&nbsp;</TD>
                    <TD BGCOLOR="#ADD8E6"> &nbsp; </TD><TD ALIGN="LEFT">Exercised (Phase 2-4)</TD>
                    <TD>&nbsp;&nbsp;</TD>
                    <TD BGCOLOR="#FFFACD"> &nbsp; </TD><TD ALIGN="LEFT">Lightly tested (Phase 5-9)</TD>
                    <TD>&nbsp;&nbsp;</TD>
                    <TD BGCOLOR="#FFD700"> &nbsp; </TD><TD ALIGN="LEFT">Human gate</TD>
                </TR>
            </TABLE>
        >]
    }
}
