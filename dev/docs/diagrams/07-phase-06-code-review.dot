// Phase 6: Code Review — Task Flow
// Generated: 2026-03-01 from codebase analysis

digraph phase_06_code_review {
    rankdir=TB
    fontname="Helvetica"
    fontsize=16
    label="Phase 6: Code Review \u2014 4-Dimensional Review"
    labelloc=t
    labeljust=c
    pad=0.3
    nodesep=0.3
    ranksep=0.4
    splines=true
    bgcolor=white

    node [fontname="Helvetica", fontsize=10, style="filled,rounded", shape=box, margin="0.12,0.06"]
    edge [fontname="Helvetica", fontsize=8, arrowsize=0.7]

    // ── Pre-review tasks ──
    t601 [label="601  Entry & Init\nValidate Phase 5 closeout", fillcolor="#FFFACD"]
    t602 [label="602  Agent Selection\n5 agents: deep, arch, perf, doc, refiner", fillcolor="#FFFACD"]

    t601 -> t602

    // ── Parallel review ──
    subgraph cluster_review {
        label="Task 603: Parallel Review (TeamSession)"
        labeljust=c
        fontsize=10
        style="filled,rounded"
        color="#CC0066"
        fillcolor="#FFF0F5"
        margin=10

        node [fontsize=9, margin="0.08,0.04"]

        deep [label="Deep Code\nbugs, security\n[sonnet]", fillcolor="#FFB6C1"]
        arch [label="Architecture\npatterns, coupling\n[sonnet]", fillcolor="#FFB6C1"]
        perf [label="Performance\nbottlenecks\n[haiku]", fillcolor="#FFB6C1"]
        doc  [label="Documentation\ncompleteness\n[haiku]", fillcolor="#FFB6C1"]

        {rank=same; deep; arch; perf; doc}

        findings [label="Findings Aggregation\ncritical | major | minor | suggestions", fillcolor="#FFDAB9"]
        deep -> findings
        arch -> findings
        perf -> findings
        doc -> findings
    }

    // ── Refinement ──
    subgraph cluster_refine {
        label="Task 604: Refinement  [sonnet]"
        labeljust=c
        fontsize=10
        style="filled,rounded"
        color="#228B22"
        fillcolor="#F0FFF0"
        margin=10

        node [fontsize=9]
        scope [label="Select scope\ncritical / major / minor", shape=diamond, fillcolor="#FFD700", fontsize=8]
        fix [label="Per-finding fixes\ngenerate + apply patches", fillcolor="#90EE90"]
        verify_fix [label="Verify fixes\nre-run affected tests", fillcolor="#90EE90"]

        scope -> fix -> verify_fix
    }

    // ── Post-review ──
    t605 [label="605  Phase Audit (non-blocking)", fillcolor="#E8E8E8"]
    t606 [label="606  Closeout\nMemory checkpoint", fillcolor="#E8E8E8"]
    next [label="Phase 7: Integration  \u2192", fillcolor="#B3D9FF", style="filled,rounded,bold"]

    t602 -> deep [lhead=cluster_review]
    findings -> scope [lhead=cluster_refine]
    verify_fix -> t605 -> t606 -> next

    // ── Human gates ──
    node [shape=diamond, fillcolor="#FFD700", fontsize=8, margin="0.08,0.04"]
    h_scope [label="Human:\nscope choice"]
    h_close [label="HUMAN GATE\nCloseout"]
    h_scope -> scope [style=dashed, color="#CC0000", arrowsize=0.5]
    h_close -> t606 [style=dashed, color="#CC0000", arrowsize=0.5]
    {rank=same; t606; h_close}

    // ── Knowledge Graph ──
    node [shape=cylinder, fillcolor="#E8D5F5", fontsize=8]
    kg [label="Knowledge Graph\nReviewFinding nodes"]
    findings -> kg [style=dashed, color="#8B008B", arrowsize=0.5]

    // ── Outputs ──
    node [shape=note, fillcolor="#FFFACD", fontsize=8, margin="0.08,0.04"]
    o_findings [label=".claude/reviews/findings.json\nseverity counts, code locations"]
    o_refine [label=".claude/reviews/refinement-report.json\npatches applied, tests verified"]

    findings -> o_findings [style=dashed, color="#4169E1", arrowsize=0.5]
    verify_fix -> o_refine [style=dashed, color="#4169E1", arrowsize=0.5]
}
