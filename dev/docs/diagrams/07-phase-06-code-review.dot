// Phase 6: Code Review — Task Flow
// 4-dimensional parallel review with TeamSession + per-finding refinement
// Generated: 2026-03-01 from codebase analysis

digraph phase_06_code_review {
    rankdir=TB
    fontname="Helvetica"
    fontsize=14
    label="Phase 6: Code Review — 4-Dimensional Parallel Review"
    labelloc=t
    pad=0.5
    nodesep=0.5
    ranksep=0.7

    node [fontname="Helvetica", fontsize=10, style=filled, shape=box]
    edge [fontname="Helvetica", fontsize=9]

    // Tasks
    t601 [label="Task 601\nEntry & Initialization\n─────────────\nValidate Phase 5 closeout\nDisplay review overview", fillcolor="#ADD8E6"]
    t602 [label="Task 602\nAgent Selection\n─────────────\ndeep-code-reviewer\narch-reviewer\nperf-reviewer\ndoc-reviewer\ncode-refiner", fillcolor="#ADD8E6"]

    // Review cluster
    subgraph cluster_review {
        label="Task 603: Comprehensive Review (TeamSession)"
        style=filled
        fillcolor="#FFF0F5"
        color="#CC0066"

        deep [label="Deep Code Review\nLogic, bugs, security\n(sonnet)", shape=box, fillcolor="#FFB6C1"]
        arch [label="Architecture Review\nPatterns, coupling\n(sonnet)", shape=box, fillcolor="#FFB6C1"]
        perf [label="Performance Review\nBottlenecks, complexity\n(haiku)", shape=box, fillcolor="#FFB6C1"]
        doc [label="Documentation Review\nCompleteness, accuracy\n(haiku)", shape=box, fillcolor="#FFB6C1"]

        // These run in parallel
        {rank=same; deep; arch; perf; doc}

        findings [label="Findings Aggregation\n─────────────\ncritical | major\nminor | suggestions", shape=box, fillcolor="#FFDAB9"]
        deep -> findings
        arch -> findings
        perf -> findings
        doc -> findings
    }

    // Refinement cluster
    subgraph cluster_refine {
        label="Task 604: Refinement"
        style=filled
        fillcolor="#F0FFF0"
        color="#228B22"

        scope [label="Scope Selection\n(human chooses:\ncritical / major / minor)", shape=diamond, fillcolor="#FFD700"]
        fix [label="Per-Finding Fixes\ncode-refiner (sonnet)\nGenerate + apply patches", shape=box, fillcolor="#90EE90"]
        verify_fix [label="Verify Fixes\nRe-run affected tests", shape=box, fillcolor="#90EE90"]

        scope -> fix -> verify_fix
    }

    t605 [label="Task 605\nPhase Audit\n(non-blocking)", fillcolor="#E8E8E8"]
    t606 [label="Task 606\nCloseout\n─────────────\nMemory checkpoint:\ncritical found/fixed\nmajor issues\ntests passing", fillcolor="#E8E8E8"]

    t601 -> t602 -> deep [lhead=cluster_review]
    findings -> scope [lhead=cluster_refine]
    verify_fix -> t605 -> t606

    // Inputs
    node [shape=note, fillcolor="#FFFACD"]
    i_src [label="Source code\n+ test files\n(from Phase 5)"]
    i_tdd [label=".claude/testing/\ntdd-progress.json"]
    i_src -> deep [style=dotted, color="#666666"]
    i_tdd -> deep [style=dotted, color="#666666"]

    // LLM
    node [shape=oval, fillcolor="#98FB98"]
    llm_sonnet [label="sonnet\ndeep-code, arch\ncode-refiner"]
    llm_haiku [label="haiku\nperf, doc"]
    llm_sonnet -> deep [style=dashed, color="#228B22"]
    llm_haiku -> perf [style=dashed, color="#228B22"]

    // Outputs
    node [shape=note, fillcolor="#FFFACD"]
    o_findings [label=".claude/reviews/\nfindings.json\n─────────────\nSeverity counts\nDetailed issues\nCode locations"]
    o_refine [label=".claude/reviews/\nrefinement-report.json\n─────────────\nPatches applied\nTests verified\nRemaining issues"]

    findings -> o_findings [style=dashed, color="#4169E1"]
    verify_fix -> o_refine [style=dashed, color="#4169E1"]

    // Knowledge graph
    node [shape=cylinder, fillcolor="#DDA0DD"]
    kg [label="Knowledge Graph\nReviewFinding nodes"]
    findings -> kg [style=dashed, color="#8B008B"]

    // Human gates
    node [shape=octagon, fillcolor="#FFD700"]
    h602 [label="Human:\nagent selection"]
    h604 [label="Human:\nrefinement scope"]
    h606 [label="HUMAN GATE\nCloseout Approval"]
    h602 -> t602 [style=dashed, color="#CC0000"]
    h604 -> scope [style=dashed, color="#CC0000"]
    h606 -> t606 [style=dashed, color="#CC0000"]

    // TeamSession note
    node [shape=component, fillcolor="#E0FFE0"]
    ts [label="TeamSession\n(tmux/threads)\n4 agents in parallel\nFallback: sequential"]
    ts -> deep [style=dotted, color="#666666"]

    // Next phase
    node [shape=box, fillcolor="#B3D9FF", style="filled,bold"]
    next [label="→ Phase 7: Integration"]
    t606 -> next
}
