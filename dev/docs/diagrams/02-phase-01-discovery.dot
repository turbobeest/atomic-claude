// Phase 1: Discovery — Task Flow
// Generated: 2026-03-01 from codebase analysis

digraph phase_01_discovery {
    rankdir=TB
    fontname="Helvetica"
    fontsize=16
    label="Phase 1: Discovery"
    labelloc=t
    labeljust=c
    pad=0.3
    nodesep=0.35
    ranksep=0.4
    splines=true
    bgcolor=white

    node [fontname="Helvetica", fontsize=10, style="filled,rounded", shape=box, margin="0.12,0.06"]
    edge [fontname="Helvetica", fontsize=8, arrowsize=0.7]

    // ── Task spine ──
    t101 [label="101  Corpus Analysis\nAnalyze reference materials  [haiku]", fillcolor="#90EE90"]
    t102 [label="102  Import Requirements\nParse RST/JSON/YAML/CSV  (optional)", fillcolor="#90EE90"]
    t103 [label="103  Agent Selection\nSelect from 221 agents  [haiku]", fillcolor="#90EE90"]
    t104 [label="104  Opening Dialogue\nMulti-turn vision/constraints  [opus]", fillcolor="#90EE90"]
    t105 [label="105  Discovery Conversation\nConference table: 6 agents  [opus]", fillcolor="#FFD700"]
    t106 [label="106  Approach Selection\nReview consensus, edit inline", fillcolor="#FFD700", style="filled,rounded,bold"]
    t107 [label="107  Discovery Diagrams\nC4, data flow, sequence, ER  [opus]", fillcolor="#90EE90"]
    t108 [label="108  Phase Audit", fillcolor="#E8E8E8"]
    t109 [label="109  Closeout", fillcolor="#E8E8E8"]
    next [label="Phase 2: PRD  \u2192", fillcolor="#B3D9FF", style="filled,rounded,bold"]

    t101 -> t102 -> t103 -> t104 -> t105 -> t106 -> t107 -> t108 -> t109 -> next

    // ── Human gate ──
    node [shape=diamond, fillcolor="#FFD700", fontsize=8, width=0.2, height=0.2, margin="0.08,0.04"]
    hgate [label="HUMAN GATE\nApproach Approval"]
    hgate -> t106 [style=dashed, color="#CC0000", arrowsize=0.5]
    {rank=same; t106; hgate}

    // ── Cross-task data flow ──
    edge [style=dotted, color="#666666", arrowsize=0.5, constraint=false]
    t101 -> t104 [label="corpus context"]
    t103 -> t105 [label="agent panel"]
    t104 -> t105 [label="dialogue context"]

    // ── Knowledge Graph writes ──
    node [shape=cylinder, fillcolor="#E8D5F5", fontsize=8]
    kg [label="Knowledge Graph\nsources, reqs, agents"]
    t101 -> kg [style=dashed, color="#8B008B", arrowsize=0.5]
    t103 -> kg [style=dashed, color="#8B008B", arrowsize=0.5]
    {rank=same; t101; kg}

    // ── Outputs ──
    node [shape=note, fillcolor="#FFFACD", fontsize=8, margin="0.08,0.04"]
    outputs [label=".outputs/1-discovery/\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\ncorpus.json\nselected-agents.json\ndialogue.json\napproaches.json\nselected-approach.json\ndocs/diagrams/*.dot"]

    t109 -> outputs [style=dashed, color="#4169E1", arrowsize=0.5, constraint=false]
    {rank=same; t109; outputs}
}
