// Phase 1: Discovery — Task Flow
// Corpus analysis, agent selection, dialogue, deliberation, approach selection, diagrams
// Generated: 2026-03-01 from codebase analysis

digraph phase_01_discovery {
    rankdir=TB
    fontname="Helvetica"
    fontsize=14
    label="Phase 1: Discovery — Task Flow & Data Dependencies"
    labelloc=t
    pad=0.5
    nodesep=0.5
    ranksep=0.7

    node [fontname="Helvetica", fontsize=10, style=filled, shape=box]
    edge [fontname="Helvetica", fontsize=9]

    // Tasks
    t101 [label="Task 101\nEntry & Corpus Analysis\n─────────────\nValidate Phase 0 closeout\nAnalyze reference materials", fillcolor="#90EE90"]
    t102 [label="Task 102\nImport Requirements\n─────────────\nParse RST/JSON/YAML/CSV\n(optional)", fillcolor="#90EE90"]
    t103 [label="Task 103\nAgent Selection\n─────────────\nSelect from 221 agents\nAI suggests SMEs", fillcolor="#90EE90"]
    t104 [label="Task 104\nOpening Dialogue\n─────────────\nMulti-turn conversation:\nvision, impact, constraints\nCanvas tracks PRD coverage", fillcolor="#90EE90"]
    t105 [label="Task 105\nDiscovery Conversation\n─────────────\nConference table:\norchestrator + facilitator\n+ analyst + 3 experts\nGenerate approaches, consensus", fillcolor="#FFD700"]
    t106 [label="Task 106\nApproach Selection\n─────────────\nReview consensus\nEdit decisions inline\nHUMAN GATE: Approve", fillcolor="#FFD700", style="filled,bold"]
    t107 [label="Task 107\nDiscovery Diagrams\n─────────────\nC4, data flow, sequence,\nstate, deployment, ER\nin DOT format → SVG", fillcolor="#90EE90"]
    t108 [label="Task 108\nPhase Audit\n─────────────\nNon-blocking audit", fillcolor="#E8E8E8"]
    t109 [label="Task 109\nCloseout\n─────────────\nApproval gate", fillcolor="#E8E8E8"]

    t101 -> t102 -> t103 -> t104 -> t105 -> t106 -> t107 -> t108 -> t109

    // Outputs
    node [shape=note, fillcolor="#FFFACD"]
    o_corpus [label="corpus.json\ncorpus-analysis.md"]
    o_needs [label="needs-index.json"]
    o_agents [label="selected-agents.json\nagent-roster.json"]
    o_dialogue [label="dialogue.json\nconversation-log.md"]
    o_consensus [label="approaches.json\nconsensus.json"]
    o_approach [label="selected-approach.json\nselected-approach.md"]
    o_diagrams [label="docs/diagrams/\n*.dot + *.svg"]

    t101 -> o_corpus [style=dashed, color="#4169E1"]
    t102 -> o_needs [style=dashed, color="#4169E1"]
    t103 -> o_agents [style=dashed, color="#4169E1"]
    t104 -> o_dialogue [style=dashed, color="#4169E1"]
    t105 -> o_consensus [style=dashed, color="#4169E1"]
    t106 -> o_approach [style=dashed, color="#4169E1"]
    t107 -> o_diagrams [style=dashed, color="#4169E1"]

    // Output directory
    node [shape=folder, fillcolor="#E0E0FF"]
    outdir [label=".outputs/1-discovery/"]

    // LLM usage
    node [shape=oval, fillcolor="#98FB98"]
    llm_haiku [label="haiku\ncorpus analysis\nagent suggestions"]
    llm_opus1 [label="opus\nmulti-turn dialogue\n(min 3 turns)"]
    llm_opus2 [label="opus\nmulti-agent\ndeliberation\n(HEAVY)"]
    llm_opus3 [label="opus\ndiagram generation"]

    llm_haiku -> t101 [style=dashed, color="#228B22"]
    llm_haiku -> t103 [style=dashed, color="#228B22"]
    llm_opus1 -> t104 [style=dashed, color="#228B22"]
    llm_opus2 -> t105 [style=dashed, color="#228B22"]
    llm_opus3 -> t107 [style=dashed, color="#228B22"]

    // Knowledge graph
    node [shape=cylinder, fillcolor="#DDA0DD"]
    kg [label="Knowledge Graph\nsources, requirements\nagents"]
    t101 -> kg [style=dashed, color="#8B008B"]
    t102 -> kg [style=dashed, color="#8B008B"]
    t103 -> kg [style=dashed, color="#8B008B"]

    // Human interaction
    node [shape=octagon, fillcolor="#FFD700"]
    h106 [label="HUMAN GATE\nApproach\napproval"]
    h106 -> t106 [style=dashed, color="#CC0000"]

    // Cross-task data flow
    o_corpus -> t104 [style=dotted, color="#666666", label="context"]
    o_agents -> t105 [style=dotted, color="#666666", label="panel"]
    o_dialogue -> t105 [style=dotted, color="#666666", label="context"]

    // Next phase
    node [shape=box, fillcolor="#B3D9FF", style="filled,bold"]
    next [label="→ Phase 2: PRD"]
    t109 -> next
}
