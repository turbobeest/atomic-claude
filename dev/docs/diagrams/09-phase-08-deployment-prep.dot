// Phase 8: Deployment Prep — Task Flow
// Artifact generation via LLM with retry/cache fallback
// Generated: 2026-03-01 from codebase analysis

digraph phase_08_deployment_prep {
    rankdir=TB
    fontname="Helvetica"
    fontsize=14
    label="Phase 8: Deployment Prep — Artifact Generation & Approval"
    labelloc=t
    pad=0.5
    nodesep=0.5
    ranksep=0.7

    node [fontname="Helvetica", fontsize=10, style=filled, shape=box]
    edge [fontname="Helvetica", fontsize=9]

    // Tasks
    t801 [label="Task 801\nEntry & Initialization\n─────────────\nValidate Phase 7 closeout\nPresent objectives", fillcolor="#ADD8E6"]
    t802 [label="Task 802\nDeployment Setup\n─────────────\nRelease type:\nmajor / minor / patch\nSemVer version\nChannels: [internal]", fillcolor="#ADD8E6"]
    t803 [label="Task 803\nAgent Selection\n─────────────\npackage-builder\nchangelog-writer\ndocs-generator\ninstall-guide-writer", fillcolor="#ADD8E6"]

    // Artifact generation cluster
    subgraph cluster_artifacts {
        label="Task 804: Artifact Generation (4 LLM calls)"
        style=filled
        fillcolor="#FFFFF0"
        color="#CC6600"

        pkg [label="Package\ntar.gz + wheel\n(sonnet)", shape=box, fillcolor="#FFE4B5"]
        changelog [label="Changelog\nCHANGELOG.md\n(sonnet)", shape=box, fillcolor="#FFE4B5"]
        docs [label="Documentation\nREADME, guides\n(sonnet)", shape=box, fillcolor="#FFE4B5"]
        install [label="Installation Guide\nINSTALL.md\n(sonnet)", shape=box, fillcolor="#FFE4B5"]

        {rank=same; pkg; changelog; docs; install}

        manifest [label="Artifact Manifest\nartifacts.json\nstatus per artifact", shape=box, fillcolor="#FFDAB9"]
        pkg -> manifest
        changelog -> manifest
        docs -> manifest
        install -> manifest
    }

    t805 [label="Task 805\nPhase Audit\n(non-blocking)", fillcolor="#E8E8E8"]
    t806 [label="Task 806\nDeployment Approval\n─────────────\nHUMAN GATE\napprove / revise / discuss", fillcolor="#FFD700", style="filled,bold"]
    t807 [label="Task 807\nCloseout", fillcolor="#E8E8E8"]

    t801 -> t802 -> t803 -> pkg [lhead=cluster_artifacts]
    manifest -> t805 -> t806 -> t807

    // Inputs
    node [shape=note, fillcolor="#FFFACD"]
    i_prd [label="docs/prd/PRD.md\n(project context)"]
    i_integration [label=".claude/integration/\napproval.json"]
    i_prd -> pkg [style=dotted, color="#666666"]
    i_integration -> pkg [style=dotted, color="#666666"]

    // LLM
    node [shape=oval, fillcolor="#98FB98"]
    llm [label="sonnet\n4 artifact generators\n2 retries each\ncache fallback"]
    llm -> pkg [style=dashed, color="#228B22"]

    // Retry/fallback detail
    node [shape=component, fillcolor="#E0FFE0"]
    retry [label="Retry Logic\n─────────────\nAttempt 1 → LLM\nAttempt 2 → LLM\nFallback → cached result\nFinal → status: failed"]
    retry -> pkg [style=dotted, color="#666666"]

    // Outputs
    node [shape=note, fillcolor="#FFFACD"]
    o_setup [label=".claude/deployment/\nsetup.json\n─────────────\nrelease_type\nversion (SemVer)\nchannels"]
    o_artifacts [label=".claude/deployment/\nartifacts.json\n─────────────\npackage, changelog\ndocs, install\nstatus per artifact"]
    o_dist [label="dist/\n─────────────\nRelease packages\n(tar.gz, wheel)"]
    o_approval [label=".claude/deployment/\napproval.json"]

    t802 -> o_setup [style=dashed, color="#4169E1"]
    manifest -> o_artifacts [style=dashed, color="#4169E1"]
    pkg -> o_dist [style=dashed, color="#4169E1"]
    t806 -> o_approval [style=dashed, color="#4169E1"]

    // Human gates
    node [shape=octagon, fillcolor="#FFD700"]
    h802 [label="Human:\nversion confirm\n(loop until valid)"]
    h806 [label="HUMAN GATE\nDeployment\nApproval"]
    h802 -> t802 [style=dashed, color="#CC0000"]
    h806 -> t806 [style=dashed, color="#CC0000"]

    // Next phase
    node [shape=box, fillcolor="#B3D9FF", style="filled,bold"]
    next [label="→ Phase 9: Release"]
    t807 -> next
}
