// Phase 8: Deployment Prep — Task Flow
// Generated: 2026-03-01 from codebase analysis

digraph phase_08_deployment_prep {
    rankdir=TB
    fontname="Helvetica"
    fontsize=16
    label="Phase 8: Deployment Prep \u2014 Artifacts & Approval"
    labelloc=t
    labeljust=c
    pad=0.3
    nodesep=0.3
    ranksep=0.45
    splines=true
    bgcolor=white

    node [fontname="Helvetica", fontsize=10, style="filled,rounded", shape=box, margin="0.12,0.06"]
    edge [fontname="Helvetica", fontsize=8, arrowsize=0.7]

    // ── Task spine ──
    t801 [label="801  Entry & Init\nValidate Phase 7 closeout", fillcolor="#FFFACD"]
    t802 [label="802  Deployment Setup\nRelease type, SemVer version", fillcolor="#FFFACD"]
    t803 [label="803  Agent Selection\npackage-builder, changelog-writer,\ndocs-generator, install-guide-writer", fillcolor="#FFFACD"]

    t801 -> t802 -> t803

    // ── Artifact generation ──
    subgraph cluster_artifacts {
        label="Task 804: Artifact Generation  [sonnet \u00d7 4]"
        labeljust=c
        fontsize=10
        style="filled,rounded"
        color="#CC6600"
        fillcolor="#FFFFF0"
        margin=10

        node [fontsize=9, margin="0.08,0.04"]
        pkg [label="Package\ntar.gz + wheel", fillcolor="#FFE4B5"]
        changelog [label="Changelog\nCHANGELOG.md", fillcolor="#FFE4B5"]
        docs [label="Documentation\nREADME, guides", fillcolor="#FFE4B5"]
        installg [label="Install Guide\nINSTALL.md", fillcolor="#FFE4B5"]

        {rank=same; pkg; changelog; docs; installg}

        manifest [label="Artifact Manifest\nstatus per artifact", fillcolor="#FFDAB9"]
        pkg -> manifest
        changelog -> manifest
        docs -> manifest
        installg -> manifest

        retry [label="2 retries \u2192 cache fallback \u2192 failed", shape=plaintext, fontsize=7, fillcolor="#FFFFF0"]
    }

    // ── Post-generation ──
    t805 [label="805  Phase Audit", fillcolor="#E8E8E8"]
    t806 [label="806  Deployment Approval\napprove / revise / discuss", fillcolor="#FFD700", style="filled,rounded,bold"]
    t807 [label="807  Closeout", fillcolor="#E8E8E8"]
    next [label="Phase 9: Release  \u2192", fillcolor="#B3D9FF", style="filled,rounded,bold"]

    t803 -> pkg [lhead=cluster_artifacts]
    manifest -> t805 -> t806 -> t807 -> next

    // ── Human gates ──
    node [shape=diamond, fillcolor="#FFD700", fontsize=8, margin="0.08,0.04"]
    h_ver [label="version\nconfirm loop"]
    h_deploy [label="HUMAN GATE\nDeployment Approval"]
    h_ver -> t802 [style=dashed, color="#CC0000", arrowsize=0.5]
    h_deploy -> t806 [style=dashed, color="#CC0000", arrowsize=0.5]
    {rank=same; t802; h_ver}
    {rank=same; t806; h_deploy}

    // ── Outputs ──
    node [shape=note, fillcolor="#FFFACD", fontsize=8, margin="0.08,0.04"]
    o_setup [label=".claude/deployment/setup.json\nrelease_type, version, channels"]
    o_artifacts [label=".claude/deployment/artifacts.json\ndist/ packages"]
    o_approval [label=".claude/deployment/approval.json"]

    t802 -> o_setup [style=dashed, color="#4169E1", arrowsize=0.5]
    manifest -> o_artifacts [style=dashed, color="#4169E1", arrowsize=0.5]
    t806 -> o_approval [style=dashed, color="#4169E1", arrowsize=0.5]
}
