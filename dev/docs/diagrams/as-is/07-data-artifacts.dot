// Atomic Claude 2.0 — Data & Artifact Flow (As-Is)
// What files are produced, consumed, and where they live
//
// Generated: 2026-02-15

digraph data_artifacts {
    rankdir=LR
    compound=true
    fontname="Helvetica"
    fontsize=14
    label="Data & Artifact Flow (As-Is)\nRuntime Directories: .state/ .outputs/ .logs/"
    labelloc=t
    labeljust=l
    pad=0.5
    nodesep=0.3
    ranksep=1.0

    node [fontname="Helvetica", fontsize=9, style=filled]
    edge [fontname="Helvetica", fontsize=8]

    // =============================================
    // .state/ — Pipeline State (ephemeral, rebuildable)
    // =============================================

    subgraph cluster_state {
        label=".state/ — Pipeline State"
        style=filled
        fillcolor="#FFF0F5"
        color="#CD5C5C"

        ts [label="task-state.json\n\ncurrent_phase\ncurrent_task\nphases: {\n  N-name: {\n    status, tasks: {\n      NNN: { status,\n        started_at,\n        completed_at,\n        artifacts }\n    }\n  }\n}", shape=note, fillcolor="#FFE4E1"]

        ct [label="current-task.json\n(transient — deleted\nwhen phase completes)\n\n{ task_id, task_name,\n  model, provider,\n  agent_roster }",
            shape=note, fillcolor="#FFE4E1"]

        mo [label="model-overrides.json\n\n{ agent_name: {\n    tier, provider,\n    model_id, context,\n    effort } }",
            shape=note, fillcolor="#FFE4E1"]

        stok [label="session-tokens.json\n\n{ total_input_tokens,\n  total_output_tokens,\n  estimated_cost_usd,\n  by_provider,\n  by_model }",
              shape=note, fillcolor="#FFE4E1"]

        lock [label="state.lock\n(fcntl file lock)",
              shape=note, fillcolor="#FFE4E1"]

        // Memory subdirectory
        subgraph cluster_state_memory {
            label=".state/memory/"
            style=dashed
            color="#9370DB"

            memjson [label="memory.json\n(append-only log\nall entries)",
                     shape=cylinder, fillcolor="#E8E0F3"]
            memhead [label="memory-head.json",
                     shape=note, fillcolor="#E8E0F3"]
            memidx [label="memory-index.json",
                    shape=note, fillcolor="#E8E0F3"]
            memmd0 [label="phase-0/\n  task_001.md\n  task_002.md\n  task_003.md\n  task_004.md\n  task_005.md",
                    shape=folder, fillcolor="#E8E0F3"]
            memmd1 [label="phase-1/\n  task_101.md\n  ...\n  task_109.md",
                    shape=folder, fillcolor="#E8E0F3"]
        }

        // Checkpoint subdirectory
        subgraph cluster_state_ckpt {
            label=".state/memory-checkpoints/"
            style=dashed
            color="#9370DB"

            ckpt [label="phase0-*.json\nphase1-*.json\n...\n(phase boundary\nsnapshots)",
                  shape=folder, fillcolor="#E8E0F3"]
        }

        // Snapshot subdirectory
        subgraph cluster_state_snap {
            label=".state/snapshots/"
            style=dashed
            color="#CD5C5C"

            snaps [label="Named state\nsnapshots\n(for rollback)",
                   shape=folder, fillcolor="#FFE4E1"]
        }
    }

    // =============================================
    // .outputs/ — Phase Artifacts (durable, meaningful)
    // =============================================

    subgraph cluster_outputs {
        label=".outputs/ — Phase Artifacts"
        style=filled
        fillcolor="#F0FFF0"
        color="#228B22"

        subgraph cluster_out0 {
            label="0-setup/"
            style=dashed
            color="#228B22"

            o0_cfg [label="project-config.json\n(project name, type,\nLLM config, mode,\ngates, constraints)",
                    shape=note, fillcolor="#B0E0B0"]
            o0_prov [label="provider-inventory.json\n(detected providers,\nhealth, credentials)",
                     shape=note, fillcolor="#B0E0B0"]
            o0_mat [label="material-manifest.json\n(files, lines,\nlanguages, frameworks)",
                    shape=note, fillcolor="#B0E0B0"]
            o0_env [label="env-validation.json\n(agents, audits, skills,\ngit, system specs)",
                    shape=note, fillcolor="#B0E0B0"]
            o0_cl [label="closeout.json",
                   shape=note, fillcolor="#FFD700"]
        }

        subgraph cluster_out1 {
            label="1-discovery/"
            style=dashed
            color="#228B22"

            o1_corp [label="corpus.json\n(materials, analysis,\nhuman feedback)",
                     shape=note, fillcolor="#B0E0B0"]
            o1_reqs [label="imported-requirements.json\n(if any)", shape=note, fillcolor="#B0E0B0"]
            o1_agt [label="selected-agents.json\n(expert roster)", shape=note, fillcolor="#B0E0B0"]
            o1_dial [label="dialogue.json\n(conversation +\nsynthesis: vision,\nimpact, constraints)",
                     shape=note, fillcolor="#B0E0B0"]
            o1_appr [label="approaches.json\n(generated approaches)",
                     shape=note, fillcolor="#B0E0B0"]
            o1_cons [label="consensus.json\n(agreed direction)",
                     shape=note, fillcolor="#B0E0B0"]
            o1_sel [label="selected-approach.json\n+ direction-confirmed.json",
                    shape=note, fillcolor="#B0E0B0"]
            o1_delib [label="deliberation-log.md\nconversation.md",
                      shape=note, fillcolor="#B0E0B0"]
            o1_cl [label="closeout.json",
                   shape=note, fillcolor="#FFD700"]
        }

        subgraph cluster_out2 {
            label="2-prd/"
            style=dashed
            color="#4682B4"

            o2_prd [label="PRD.md\n(also → ../docs/prd/)\nrequirements.json\nstakeholder-review.json",
                    shape=note, fillcolor="#ADD8E6"]
            o2_cl [label="closeout.json",
                   shape=note, fillcolor="#FFD700"]
        }

        subgraph cluster_out3 {
            label="3-tasking/"
            style=dashed
            color="#4682B4"

            o3_tasks [label="raw-tasks.json\n→ .taskmaster/tasks/tasks.json\ndependency-graph.json\nestimation.json",
                      shape=note, fillcolor="#ADD8E6"]
            o3_cl [label="closeout.json",
                   shape=note, fillcolor="#FFD700"]
        }

        subgraph cluster_out49 {
            label="4-9 (spec through release)"
            style=dashed
            color="#DAA520"

            o49 [label="4-specification/\n  openspec/*.json\n5-implementation/\n  code generation artifacts\n6-review/\n  review-report.md, findings.json\n7-integration/\n  test-results.json\n8-deployment/\n  deployment-config.json\n9-release/\n  release-notes.md",
                 shape=note, fillcolor="#FFFACD"]
        }
    }

    // =============================================
    // .logs/ — Execution Logs
    // =============================================

    subgraph cluster_logs {
        label=".logs/"
        style=filled
        fillcolor="#F5F5F5"
        color="#696969"

        errlog [label="errors.json\n[\n  { phase, task,\n    error, traceback,\n    timestamp }\n]",
                shape=note, fillcolor="#D3D3D3"]
    }

    // =============================================
    // docs/ — Persistent Documentation
    // =============================================

    subgraph cluster_docs {
        label="docs/ (version controlled)"
        style=filled
        fillcolor="#F0F8FF"
        color="#4682B4"

        diagrams [label="docs/diagrams/\n  *.dot + *.svg\n  manifest.json\n\nGenerated by Task 107",
                  shape=folder, fillcolor="#87CEEB"]

        closeout_docs [label=".claude/closeout/\n  phase-01-closeout.md\n  phase-01-closeout.json\n\nGenerated by closeout tasks",
                       shape=folder, fillcolor="#87CEEB"]

        reference [label="docs/reference/\n\nExternal materials\ncollected by Task 004",
                   shape=folder, fillcolor="#87CEEB"]
    }

    // =============================================
    // config/ — Tool Configuration
    // =============================================

    subgraph cluster_config {
        label="config/ (version controlled)"
        style=filled
        fillcolor="#FFFFF0"
        color="#DAA520"

        models [label="models.json\n(tier definitions,\nfallback chains,\nrole mapping)",
                shape=note, fillcolor="#F0E68C"]

        dotenv [label=".env\n(gitignored)\nATOMIC_*, CLAUDE_*,\nAWS_* vars",
                shape=note, fillcolor="#F0E68C"]
    }

    // =============================================
    // CROSS-PHASE DEPENDENCIES (artifact consumption)
    // =============================================

    // Phase 0 → Phase 1
    o0_cfg -> o1_corp [label="read by\ntask 101", style=dashed, color="#228B22"]
    o0_mat -> o1_corp [label="materials\nfor corpus", style=dashed, color="#228B22"]

    // Phase 1 → Phase 2
    o1_sel -> o2_prd [label="approach\nfeeds PRD", style=dashed, color="#4682B4"]
    o1_dial -> o2_prd [label="vision/constraints\nfeed PRD", style=dashed, color="#4682B4"]
    o1_agt -> o2_prd [label="agents for\nPRD phase", style=dashed, color="#4682B4"]

    // Phase 2 → Phase 3
    o2_prd -> o3_tasks [label="PRD → task\ndecomposition", style=dashed, color="#4682B4"]

    // Phase 3 → Phase 4-9
    o3_tasks -> o49 [label="tasks drive\nspec → impl → test → deploy", style=dashed, color="#DAA520"]

    // Config feeds everything
    models -> ts [label="read by resolver", style=dotted, color="#999999", constraint=false]
    o0_cfg -> ts [label="hot-reload\nby resolver", style=dotted, color="#999999", constraint=false]

    // Dashboard reads state
    subgraph cluster_dashboard {
        label="Dashboard (port 3000)"
        style=filled
        fillcolor="#F0F8FF"
        color="#4682B4"

        dash [label="Node.js/Express\n\nGET /api/status → task-state.json\nGET /api/current → current-task.json\nGET /api/memory → memory/ markdown\nGET /api/tokens → session-tokens.json",
              shape=component, fillcolor="#87CEEB"]
    }

    ts -> dash [label="reads", style=dotted, color="#4682B4"]
    ct -> dash [label="reads", style=dotted, color="#4682B4"]
    memmd0 -> dash [label="reads", style=dotted, color="#4682B4"]
    memmd1 -> dash [label="reads", style=dotted, color="#4682B4"]
    stok -> dash [label="reads", style=dotted, color="#4682B4"]
    errlog -> dash [label="reads", style=dotted, color="#4682B4"]
}
