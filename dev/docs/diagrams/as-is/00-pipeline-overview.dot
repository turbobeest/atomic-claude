// Atomic Claude 2.0 — Pipeline Overview (As-Is)
// 10-phase SDLC pipeline with dependency gates and human checkpoints
//
// Generated: 2026-02-15
// Source of truth: main.py, orchestration/pipeline.py, phases/*/orchestratorNN.py

digraph pipeline_overview {
    rankdir=TB
    compound=true
    fontname="Helvetica"
    fontsize=14
    label="Atomic Claude 2.0 — Pipeline Overview (As-Is)\n10-Phase SDLC with Dependency Gates"
    labelloc=t
    labeljust=l
    pad=0.5
    nodesep=0.4
    ranksep=0.6

    // Global node style
    node [fontname="Helvetica", fontsize=11, style=filled]
    edge [fontname="Helvetica", fontsize=9]

    // =============================================
    // ENTRY POINT
    // =============================================

    entry [label="main.py\n(CLI Entry)", shape=box, fillcolor="#E8E8E8",
           tooltip="python main.py run <phase> [--resume-at=NNN]"]

    // =============================================
    // PIPELINE ORCHESTRATOR
    // =============================================

    pipeline [label="PhasePipeline\norchestration/pipeline.py", shape=box,
              fillcolor="#B3D9FF", style="filled,bold",
              tooltip="Validates deps → loads orchestrator → executes → transitions"]

    entry -> pipeline [label="run_phase(N)"]

    // =============================================
    // PHASES (color-coded by maturity)
    //   Green = battle-tested (Phase 0, 1)
    //   Blue  = implemented, exercised somewhat (Phase 2, 3)
    //   Yellow = implemented, lightly tested (Phase 4-9)
    // =============================================

    subgraph cluster_phases {
        label="Phases"
        style=dashed
        color="#999999"

        // Phase 0: Setup (HUMAN GATE)
        p0 [label="Phase 0: Setup\n5 tasks | orchestrator00\n.outputs/0-setup/",
            shape=box, fillcolor="#90EE90", style="filled,bold",
            tooltip="Environment bootstrap, provider detection, setup wizard, material scan, repo setup"]

        // Phase 1: Discovery
        p1 [label="Phase 1: Discovery\n9 tasks | orchestrator01\n.outputs/1-discovery/",
            shape=box, fillcolor="#90EE90",
            tooltip="Entry validation, import reqs, agent selection, dialogue, discovery work, approach selection, diagrams, audit, closeout"]

        // Phase 2: PRD (HUMAN GATE)
        p2 [label="Phase 2: PRD\n9 tasks | orchestrator02\n.outputs/2-prd/",
            shape=box, fillcolor="#ADD8E6", style="filled,bold",
            tooltip="Entry, agent selection, requirements gathering, PRD drafting, review, specs, audit, closeout"]

        // Phase 3: Tasking
        p3 [label="Phase 3: Tasking\n7 tasks | orchestrator03\n.outputs/3-tasking/",
            shape=box, fillcolor="#ADD8E6",
            tooltip="Entry, task decomposition, dependency mapping, estimation, priority, audit, closeout"]

        // Phase 4: Specification
        p4 [label="Phase 4: Specification\n6 tasks | orchestrator04\n.outputs/4-specification/",
            shape=box, fillcolor="#FFFACD",
            tooltip="Entry, OpenSpec generation, spec review, test scaffolding, audit, closeout"]

        // Phase 5: Implementation (HUMAN GATE)
        p5 [label="Phase 5: Implementation\n7 tasks | orchestrator05\n.outputs/5-implementation/",
            shape=box, fillcolor="#FFFACD", style="filled,bold",
            tooltip="Entry, agent selection, code generation, unit tests, integration, audit, closeout"]

        // Phase 6: Code Review
        p6 [label="Phase 6: Code Review\n6 tasks | orchestrator06\n.outputs/6-review/",
            shape=box, fillcolor="#FFFACD",
            tooltip="Entry, review setup, comprehensive review, fix application, audit, closeout"]

        // Phase 7: Integration
        p7 [label="Phase 7: Integration\n7 tasks | orchestrator07\n.outputs/7-integration/",
            shape=box, fillcolor="#FFFACD",
            tooltip="Entry, environment setup, component assembly, testing execution, report, audit, closeout"]

        // Phase 8: Deployment Prep
        p8 [label="Phase 8: Deployment Prep\n6 tasks | orchestrator08\n.outputs/8-deployment/",
            shape=box, fillcolor="#FFFACD",
            tooltip="Entry, environment prep, deployment config, validation, audit, closeout"]

        // Phase 9: Release (HUMAN GATE)
        p9 [label="Phase 9: Release\n5 tasks | orchestrator09\n.outputs/9-release/",
            shape=box, fillcolor="#FFFACD", style="filled,bold",
            tooltip="Entry, release packaging, documentation, final audit, closeout"]
    }

    // =============================================
    // PHASE FLOW (sequential with dependency gates)
    // =============================================

    pipeline -> p0 [label="validate deps\nimport orchestrator\nexecute"]

    p0 -> p1 [label="closeout.json\nrequired", color="#228B22", penwidth=2]
    p1 -> p2 [label="closeout.json", color="#228B22", penwidth=2]
    p2 -> p3 [label="closeout.json", color="#228B22", penwidth=2]
    p3 -> p4 [label="closeout.json", color="#228B22", penwidth=2]
    p4 -> p5 [label="closeout.json", color="#228B22", penwidth=2]
    p5 -> p6 [label="closeout.json", color="#228B22", penwidth=2]
    p6 -> p7 [label="closeout.json", color="#228B22", penwidth=2]
    p7 -> p8 [label="closeout.json", color="#228B22", penwidth=2]
    p8 -> p9 [label="closeout.json", color="#228B22", penwidth=2]

    // =============================================
    // HUMAN GATES (forced PROMPT mode)
    // =============================================

    subgraph cluster_gates {
        label="Human Gates\n(always PROMPT mode)"
        style=dashed
        color="#CC0000"
        fontcolor="#CC0000"

        gate0 [label="Gate 0\nSetup Review", shape=diamond, fillcolor="#FFD700",
               width=1.2, height=0.8]
        gate2 [label="Gate 2\nPRD Review", shape=diamond, fillcolor="#FFD700",
               width=1.2, height=0.8]
        gate5 [label="Gate 5\nImpl Review", shape=diamond, fillcolor="#FFD700",
               width=1.2, height=0.8]
        gate9 [label="Gate 9\nRelease Sign-off", shape=diamond, fillcolor="#FFD700",
               width=1.2, height=0.8]
    }

    p0 -> gate0 [style=dashed, color="#CC0000"]
    gate0 -> p1 [label="[c]ontinue", style=dashed, color="#CC0000"]

    p2 -> gate2 [style=dashed, color="#CC0000"]
    gate2 -> p3 [label="[c]ontinue", style=dashed, color="#CC0000"]

    p5 -> gate5 [style=dashed, color="#CC0000"]
    gate5 -> p6 [label="[c]ontinue", style=dashed, color="#CC0000"]

    p9 -> gate9 [style=dashed, color="#CC0000"]

    // =============================================
    // CORE SYSTEMS (supporting all phases)
    // =============================================

    subgraph cluster_core {
        label="Core Systems (shared across all phases)"
        style=filled
        color="#F0F0F0"
        fillcolor="#F8F8F8"

        state [label="StateManager\ncore/state.py\n.state/task-state.json",
               shape=cylinder, fillcolor="#FFB6C1"]
        memory [label="Memory System\ncore/memory/\n.state/memory/",
                shape=cylinder, fillcolor="#DDA0DD"]
        llm [label="LLM Router\ncore/llm/\nclaude-code → anthropic → bedrock → ollama",
             shape=box3d, fillcolor="#98FB98"]
        config [label="Config\ncore/config.py\nmodels.json + .env + project-config",
                shape=note, fillcolor="#F0E68C"]
        dashboard [label="Dashboard\nlocalhost:3000\nNode.js/Express",
                   shape=component, fillcolor="#87CEEB"]
    }

    // Core system connections (implied, not drawn to every phase)
    p0 -> state [style=dotted, color="#999999", constraint=false,
                 label="mark_task_*\nmark_phase_*"]
    p0 -> memory [style=dotted, color="#999999", constraint=false,
                  label="memory_save\nmemory_checkpoint"]
    p0 -> llm [style=dotted, color="#999999", constraint=false,
               label="invoke_llm"]
    p0 -> dashboard [style=dotted, color="#999999", constraint=false,
                     label="write_current_task\nsync_dashboard"]

    // =============================================
    // LEGEND
    // =============================================

    subgraph cluster_legend {
        label="Legend"
        style=filled
        fillcolor=white
        color="#CCCCCC"

        node [shape=plaintext, fillcolor=white]

        l1 [label="Green fill = battle-tested"]
        l2 [label="Blue fill = implemented, partially exercised"]
        l3 [label="Yellow fill = implemented, lightly tested"]
        l4 [label="Bold border = HUMAN GATE phase"]
        l5 [label="Green arrow = closeout.json dependency"]
        l6 [label="Red dashed = human gate transition"]
    }
}
