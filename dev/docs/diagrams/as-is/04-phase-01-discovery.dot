// Atomic Claude 2.0 — Phase 1: Discovery (As-Is)
// Per-task breakdown with LLM calls, user interactions, and artifacts
//
// Generated: 2026-02-15

digraph phase_01_discovery {
    rankdir=TB
    compound=true
    fontname="Helvetica"
    fontsize=14
    label="Phase 1: Discovery (As-Is)\nProject Understanding, Direction Selection, Architecture Diagrams"
    labelloc=t
    labeljust=l
    pad=0.5
    nodesep=0.4
    ranksep=0.5

    node [fontname="Helvetica", fontsize=10, style=filled]
    edge [fontname="Helvetica", fontsize=9]

    // =============================================
    // PHASE ENTRY
    // =============================================

    entry [label="Phase 1 Entry\norchestrator01.py\nRequires: .outputs/0-setup/closeout.json\nOutput: .outputs/1-discovery/",
           shape=box, fillcolor="#E8E8E8", style="filled,bold"]

    // =============================================
    // TASK 101: Entry Validation & Corpus Analysis
    // =============================================

    subgraph cluster_t101 {
        label="Task 101: Entry Validation & Corpus Analysis"
        style=filled
        fillcolor="#F0FFF0"
        color="#228B22"

        t101 [label="task_101_entry_validation.py\n\nSteps:\n1. Validate Phase 0 closeout exists\n2. Load material-manifest.json\n3. If no materials → greenfield path\n4. If materials → LLM analyzes corpus\n5. Display analysis to human\n6. Collect human feedback\n7. Save corpus.json",
              shape=box, fillcolor="#90EE90"]

        t101_llm [label="LLM: sonnet\nAnalyze project materials\nidentify stack, patterns,\nrisks, architecture",
                  shape=box3d, fillcolor="#98FB98"]

        t101_user [label="User reviews analysis\nProvides feedback text\n(mandatory)",
                   shape=ellipse, fillcolor="#FFD700"]

        t101_out [label="corpus.json\n(materials list, analysis,\nhuman feedback)",
                  shape=note, fillcolor="#B0E0B0"]
    }

    entry -> t101

    // =============================================
    // TASK 102: Import Requirements
    // =============================================

    subgraph cluster_t102 {
        label="Task 102: Import Requirements"
        style=filled
        fillcolor="#F0FFF0"
        color="#228B22"

        t102 [label="task_102_import_requirements.py\n\nSteps:\n1. Check for existing requirements files\n   (requirements.md, specs/, etc.)\n2. If found → import and categorize\n3. If none → skip with finding\n4. Save imported-requirements.json",
              shape=box, fillcolor="#90EE90"]

        t102_user [label="Optional: confirm\nimport selection", shape=ellipse, fillcolor="#FFFACD"]

        t102_out [label="imported-requirements.json\n(categorized reqs)\nOR skipped",
                  shape=note, fillcolor="#B0E0B0"]
    }

    t101 -> t102

    // =============================================
    // TASK 103: Agent Selection
    // =============================================

    subgraph cluster_t103 {
        label="Task 103: Agent Selection"
        style=filled
        fillcolor="#F0FFF0"
        color="#228B22"

        t103 [label="task_103_agent_selection.py\n\nSteps:\n1. Load agent-manifest.json (221 agents)\n2. LLM suggests domain experts\n   based on corpus + project type\n3. Display suggestions to human\n4. Human adds/removes/approves\n5. Save selected-agents.json",
              shape=box, fillcolor="#90EE90"]

        t103_llm [label="LLM: sonnet\nSuggest expert agents\nbased on project corpus",
                  shape=box3d, fillcolor="#98FB98"]

        t103_user [label="User reviews suggestions\nCan add/remove agents\nMust approve final roster",
                   shape=ellipse, fillcolor="#FFD700"]

        t103_out [label="selected-agents.json\n(selected_experts list,\ncategories, count)",
                  shape=note, fillcolor="#B0E0B0"]
    }

    t102 -> t103

    // =============================================
    // TASK 104: Opening Dialogue
    // =============================================

    subgraph cluster_t104 {
        label="Task 104: Opening Dialogue"
        style=filled
        fillcolor="#F0FFF0"
        color="#228B22"

        t104 [label="task_104_opening_dialogue.py\n\nSteps:\n1. Multi-turn conversation with user\n2. Probe: vision, impact, constraints\n3. Each turn: LLM generates question\n4. User responds naturally\n5. LLM synthesizes into structured JSON\n6. Save dialogue.json + conversation.md",
              shape=box, fillcolor="#90EE90"]

        t104_llm [label="LLM: sonnet\nGenerate probing questions\n+ synthesize conversation\ninto structured output\n(vision, impact, audience,\nconstraints, non-negotiables)",
                  shape=box3d, fillcolor="#98FB98"]

        t104_user [label="HEAVY interaction\n5+ conversation turns\nVision, goals, constraints\nNon-negotiables",
                   shape=ellipse, fillcolor="#FFD700", style="filled,bold"]

        t104_out [label="dialogue.json\n{ conversation: [...],\n  synthesis: {\n    vision, impact,\n    audience, constraints,\n    non_negotiables,\n    open_questions\n  }\n}\nconversation.md (readable)",
                  shape=note, fillcolor="#B0E0B0"]
    }

    t103 -> t104

    // =============================================
    // TASK 105: Discovery Work (Conference Table)
    // =============================================

    subgraph cluster_t105 {
        label="Task 105: Discovery Work (Conference Table)"
        style=filled
        fillcolor="#F0FFF0"
        color="#228B22"

        t105 [label="task_105_discovery_work.py\n\nSteps:\n1. Load panel: orchestrator +\n   discovery-facilitator +\n   first-principles-analyst +\n   3 expert agents\n2. Build context from corpus + dialogue\n3. Orchestrator opens deliberation\n4. Human converses freely\n   (generate/synthesize/done)\n5. LLM routes natural language input\n6. Generate approaches on command\n7. Build consensus document",
              shape=box, fillcolor="#90EE90"]

        t105_llm [label="LLM: sonnet (main)\nLLM: haiku (synthesis)\n\nOrchestrator opening\nRoute natural input\nGenerate approaches\nBuild consensus",
                  shape=box3d, fillcolor="#98FB98"]

        t105_user [label="HEAVY interaction\nFree-form conversation\nDirect agents\nRequest approaches\nClose when ready",
                   shape=ellipse, fillcolor="#FFD700", style="filled,bold"]

        t105_out [label="approaches.json\nconsensus.json\ndeliberation-log.md\ningested-context.md",
                  shape=note, fillcolor="#B0E0B0"]
    }

    t104 -> t105

    // =============================================
    // TASK 106: Approach Selection
    // =============================================

    subgraph cluster_t106 {
        label="Task 106: Approach Selection"
        style=filled
        fillcolor="#F0FFF0"
        color="#228B22"

        t106 [label="task_106_approach_selection.py\n\nSteps:\n1. Load approaches.json\n2. Display approaches with details\n3. Human selects one (by ID)\n4. Optional: modify selected approach\n5. Lock direction → save\n6. Write selected-approach.json\n   + direction-confirmed.json",
              shape=box, fillcolor="#90EE90"]

        t106_user [label="User selects approach\nOptionally modifies it\nLocks direction",
                   shape=ellipse, fillcolor="#FFD700"]

        t106_out [label="selected-approach.json\ndirection-confirmed.json",
                  shape=note, fillcolor="#B0E0B0"]
    }

    t105 -> t106

    // =============================================
    // TASK 107: Discovery Diagrams
    // =============================================

    subgraph cluster_t107 {
        label="Task 107: Discovery Diagrams"
        style=filled
        fillcolor="#F0FFF0"
        color="#228B22"

        t107 [label="task_107_discovery_diagrams.py\n\nSteps:\n1. Check graphviz installed\n2. Load approach context\n3. User selects diagram types\n   (all/minimal/standard/custom)\n4. For each type: LLM generates DOT\n5. Clean output (strip markdown fences)\n6. Convert DOT → SVG via graphviz\n7. Create manifest.json\n8. Human review + approve/retry/abort",
              shape=box, fillcolor="#90EE90"]

        t107_llm [label="LLM: sonnet\nGenerate DOT diagrams\n(system-context, container,\ncomponent, data-flow,\nsequence, state,\ndeployment, ER)",
                  shape=box3d, fillcolor="#98FB98"]

        t107_user [label="Select diagram types\nReview generated diagrams\nApprove/Retry/Abort",
                   shape=ellipse, fillcolor="#FFD700"]

        t107_out [label="docs/diagrams/\n*.dot + *.svg files\nmanifest.json",
                  shape=note, fillcolor="#B0E0B0"]
    }

    t106 -> t107

    // =============================================
    // TASK 108: Phase Audit
    // =============================================

    subgraph cluster_t108 {
        label="Task 108: Phase Audit"
        style=filled
        fillcolor="#F0FFF0"
        color="#228B22"

        t108 [label="task_108_phase_audit.py\n\nSteps:\n1. Extract phase number from output_dir\n2. Call run_phase_audit()\n3. Read audit results\n4. Always returns True (non-blocking)",
              shape=box, fillcolor="#90EE90"]

        t108_out [label=".outputs/audits/\nphase-1-report.json\n(passed/failed/warnings)",
                  shape=note, fillcolor="#B0E0B0"]

        t108_note [label="NON-BLOCKING\nAudit failures don't\nstop the pipeline",
                   shape=ellipse, fillcolor="#FFFACD"]
    }

    t107 -> t108

    // =============================================
    // TASK 109: Phase Closeout
    // =============================================

    subgraph cluster_t109 {
        label="Task 109: Phase Closeout"
        style=filled
        fillcolor="#F0FFF0"
        color="#228B22"

        t109 [label="task_109_closeout.py\n\nSteps:\n1. Check all artifacts exist\n   (corpus, dialogue, agents,\n    approaches, selected-approach)\n2. Check diagrams manifest\n3. Check audit results\n4. Display checklist (PASS/FAIL/WARN)\n5. User: approve/review/hold\n6. Generate closeout documents",
              shape=box, fillcolor="#90EE90"]

        t109_user [label="Review checklist\nApprove/Review/Hold",
                   shape=ellipse, fillcolor="#FFD700"]

        t109_out [label=".claude/closeout/\nphase-01-closeout.md\nphase-01-closeout.json",
                  shape=note, fillcolor="#B0E0B0"]
    }

    t108 -> t109

    // =============================================
    // PHASE COMPLETION
    // =============================================

    closeout [label="Phase 1 Complete\n.outputs/1-discovery/closeout.json\n\nGates Phase 2 entry",
              shape=box, fillcolor="#FFD700", style="filled,bold"]

    t109 -> closeout

    // =============================================
    // KEY OBSERVATIONS
    // =============================================

    subgraph cluster_notes {
        label="Key Observations (As-Is)"
        style=dashed
        color="#CC0000"
        fontcolor="#CC0000"

        node [shape=plaintext, fillcolor=white]

        n1 [label="Tasks 104 + 105 are the heart of Phase 1:\nheavy user interaction, multiple LLM calls,\nshape the entire project direction"]
        n2 [label="Agent panel in task 105 is static list:\norchestrator + discovery-facilitator +\nfirst-principles-analyst + 3 from selected-agents.\nNo real multi-agent deliberation — same LLM\ngenerates all 'agent' responses"]
        n3 [label="Task 107 diagram approval: was broken\n(approving 'n' did nothing), now fixed\nwith retry/continue/abort loop"]
        n4 [label="Task 108 audit is always non-blocking.\nEven critical failures don't stop closeout."]
    }
}
