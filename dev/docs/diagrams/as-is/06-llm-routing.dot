// Atomic Claude 2.0 — LLM Routing & Resolution (As-Is)
// How model selection works from task through to provider invocation
//
// Generated: 2026-02-15

digraph llm_routing {
    rankdir=TB
    compound=true
    fontname="Helvetica"
    fontsize=14
    label="LLM Routing & Resolution (As-Is)\nFrom Task Request to Provider Invocation"
    labelloc=t
    labeljust=l
    pad=0.5
    nodesep=0.4
    ranksep=0.6

    node [fontname="Helvetica", fontsize=10, style=filled]
    edge [fontname="Helvetica", fontsize=9]

    // =============================================
    // CALL SITE (in task modules)
    // =============================================

    callsite [label="Task Module\ninvoke_llm(prompt_file, output_file,\n  description, model='sonnet')\n\nOR\ninvoke_llm(prompt='...', model='opus')",
              shape=box, fillcolor="#E8E8E8", style="filled,bold"]

    // =============================================
    // MODEL RESOLUTION
    // =============================================

    subgraph cluster_resolve {
        label="Model Resolution (core/llm/resolver.py)"
        style=filled
        fillcolor="#F0FFF0"
        color="#228B22"

        resolver [label="ModelResolver.resolve(\n  phase_id, task_id,\n  agent_name, override_tier\n)", shape=box, fillcolor="#98FB98", style="filled,bold"]

        // Resolution hierarchy
        h1 [label="1. Explicit override\n(override_tier param)", shape=box, fillcolor="#C8F0C8"]
        h2 [label="2. User override\n(.state/model-overrides.json\nor in-memory task-scoped)", shape=box, fillcolor="#C8F0C8"]
        h3 [label="3. Agent preference\n(agent-manifest.json\nmodel field)", shape=box, fillcolor="#C8F0C8"]
        h4 [label="4. Phase role mapping\n(config/models.json\nrole_to_tier)", shape=box, fillcolor="#C8F0C8"]
        h5 [label="5. Global default\n(primary role → sonnet)", shape=box, fillcolor="#C8F0C8"]

        resolver -> h1 [label="first match wins"]
        h1 -> h2 [label="not set"]
        h2 -> h3 [label="not set"]
        h3 -> h4 [label="not set"]
        h4 -> h5 [label="not set"]

        // Result
        resolved [label="ResolvedModel {\n  tier: 'opus' | 'sonnet' | 'haiku'\n  model_id: 'claude-opus-4-6'\n  provider: 'claude-code'\n  context_window: 1_000_000\n  max_output: 32_000\n  effort_level: 'high'\n  source: 'override' | 'agent' | 'default'\n}",
                  shape=note, fillcolor="#B0E0B0"]
    }

    callsite -> resolver

    // =============================================
    // PROVIDER ROUTING
    // =============================================

    subgraph cluster_routing {
        label="Provider Routing (core/llm/router.py)"
        style=filled
        fillcolor="#FFF0F5"
        color="#CD5C5C"

        router [label="LLMRouter\n\nCircuit breaker:\n  fail_threshold: 3\n  cooldown: 5 min\n\nHealth checks:\n  interval: 60s",
                shape=box, fillcolor="#FFB6C1", style="filled,bold"]

        chain [label="Fallback Chain\n(priority order)\n\n1. claude-code (CLI)\n2. anthropic (SDK)\n3. aws-bedrock (boto3)\n4. ollama (local HTTP)",
               shape=box, fillcolor="#FFE4E1"]

        router -> chain [label="try in order\nskip unhealthy"]
    }

    resolved -> router [label="provider + model_id"]

    // =============================================
    // PROVIDERS
    // =============================================

    subgraph cluster_providers {
        label="Provider Implementations"
        style=filled
        fillcolor="#F0F8FF"
        color="#4682B4"

        // Claude Code
        cc [label="ClaudeCodeProvider\ncore/llm/claude_code.py\n\nclaude -p --output-format text\n  [--model claude-opus-4-6]\n  [--effort high]\n  <<< prompt\n\nRuns as subprocess\nUnsets CLAUDECODE_* env vars\nFast mode FORBIDDEN",
            shape=box, fillcolor="#87CEEB", style="filled,bold"]

        cc_note [label="Subscription-based\nNo token tracking\nNo streaming\nSupports effort flag",
                 shape=note, fillcolor="#E0F0FF"]

        // Anthropic
        anth [label="AnthropicProvider\ncore/llm/anthropic.py\n\nAnthropic Python SDK\nDirect API calls\nSupports streaming\nExtended thinking capable",
              shape=box, fillcolor="#87CEEB"]

        anth_note [label="Token-based pricing\nopus: $5/$25 per M\nsonnet: $3/$15 per M\nhaiku: $1/$5 per M",
                   shape=note, fillcolor="#E0F0FF"]

        // Bedrock
        bed [label="BedrockProvider\ncore/llm/bedrock.py\n\nboto3 bedrock-runtime\nGovCloud compatible\nRegion-aware\nProfile-aware",
             shape=box, fillcolor="#87CEEB"]

        bed_note [label="AWS pricing\nCross-region capable\nNo streaming in\ncurrent impl",
                  shape=note, fillcolor="#E0F0FF"]

        // Ollama
        oll [label="OllamaProvider\ncore/llm/ollama.py\n\nHTTP to localhost:11434\nLocal models only\nContext: 65536 default\nSupports streaming",
             shape=box, fillcolor="#87CEEB"]

        oll_note [label="Free (local)\nLatency varies\nModel-dependent\ncapability",
                  shape=note, fillcolor="#E0F0FF"]
    }

    chain -> cc [label="try first", penwidth=2]
    chain -> anth [label="if cc fails"]
    chain -> bed [label="if anth fails"]
    chain -> oll [label="last resort"]

    cc -> cc_note [style=dotted]
    anth -> anth_note [style=dotted]
    bed -> bed_note [style=dotted]
    oll -> oll_note [style=dotted]

    // =============================================
    // RESPONSE PATH
    // =============================================

    response [label="LLMResponse {\n  content: str\n  model: str\n  provider: str\n  input_tokens: int\n  output_tokens: int\n  latency_ms: int\n}",
              shape=note, fillcolor="#FFFACD"]

    cc -> response [style=dashed]
    anth -> response [style=dashed]
    bed -> response [style=dashed]
    oll -> response [style=dashed]

    // Token tracking
    tokens [label=".state/session-tokens.json\n\nAccumulates:\n  total_input_tokens\n  total_output_tokens\n  estimated_cost_usd\n  by_provider: {}\n  by_model: {}",
            shape=cylinder, fillcolor="#FFB6C1"]

    response -> tokens [label="update\n(except claude-code)"]

    // Back to caller
    output [label="Response written to\noutput_file or returned\nas string to task",
            shape=ellipse, fillcolor="#E8E8E8"]

    response -> output

    // =============================================
    // INTERACTIVE OVERRIDE PATH
    // =============================================

    subgraph cluster_override {
        label="Interactive Override (task_display.py)"
        style=dashed
        color="#DAA520"

        roster_display [label="display_task_roster()\n\nShows table:\nAgent | Provider | Model | Context | Effort\n\nUser can override:\n  1. Select agent\n  2. Pick tier (opus/sonnet/haiku)\n  3. Pick provider\n  4. Pick context window\n  5. Pick effort level\n  6. Apply: this task only or all tasks",
                        shape=box, fillcolor="#F0E68C"]

        override_store [label=".state/model-overrides.json\n(persistent overrides)\n\nOR in-memory dict\n(task-only overrides,\ncleared after task)",
                        shape=note, fillcolor="#FFF8DC"]

        roster_display -> override_store [label="set_override()"]
        override_store -> h2 [label="consulted\nduring resolve", style=dashed, constraint=false]
    }

    // =============================================
    // CONFIGURATION SOURCES
    // =============================================

    subgraph cluster_config_sources {
        label="Configuration Sources for Resolution"
        style=dashed
        color="#666666"

        models_json [label="config/models.json\n\ntier_definitions:\n  opus → claude-opus-4-6\n  sonnet → claude-sonnet-4-5\n  haiku → claude-haiku-4-5\n\nrole_to_tier:\n  primary → sonnet\n  fast → haiku\n  heavyweight → opus\n\nfallback_chains:\n  default → [claude-code, anthropic, bedrock, ollama]",
                     shape=note, fillcolor="#FFFACD"]

        manifest [label="agents/agent-manifest.json\n\n221 agents with model prefs:\n  { model: 'opus' | 'sonnet' }\n\nConsulted when resolving\nfor a specific agent",
                  shape=note, fillcolor="#FFFACD"]

        projcfg [label=".outputs/0-setup/\nproject-config.json\n\nllm: {\n  primary_provider\n  primary_model\n}\n\nHot-reloaded on\nfile modification",
                 shape=note, fillcolor="#FFFACD"]
    }

    models_json -> h4 [style=dotted, constraint=false]
    manifest -> h3 [style=dotted, constraint=false]
    projcfg -> h4 [style=dotted, constraint=false]
}
