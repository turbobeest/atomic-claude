// Atomic Claude 2.0 — Phase 0: Setup (As-Is)
// Per-task breakdown with artifacts and interactions
//
// Generated: 2026-02-15

digraph phase_00_setup {
    rankdir=TB
    compound=true
    fontname="Helvetica"
    fontsize=14
    label="Phase 0: Setup (As-Is)\nEnvironment Preparation & Project Configuration"
    labelloc=t
    labeljust=l
    pad=0.5
    nodesep=0.5
    ranksep=0.6

    node [fontname="Helvetica", fontsize=10, style=filled]
    edge [fontname="Helvetica", fontsize=9]

    // =============================================
    // PHASE ENTRY
    // =============================================

    entry [label="Phase 0 Entry\norchestrator00.py\nOutput: .outputs/0-setup/",
           shape=box, fillcolor="#E8E8E8", style="filled,bold"]

    // =============================================
    // TASK 001: Environment Bootstrap
    // =============================================

    subgraph cluster_t001 {
        label="Task 001: Environment Bootstrap"
        style=filled
        fillcolor="#F0FFF0"
        color="#228B22"

        t001 [label="task_001_environment_bootstrap.py\n\nSteps:\n1. Detect OS type (Linux/macOS/Windows)\n2. Check required tools (python, git, node, npm)\n3. Check recommended tools (graphviz, jq, curl)\n4. Launch dashboard (start-dashboard.sh)\n5. Validate dashboard health (port 3000)",
              shape=box, fillcolor="#90EE90"]

        t001_user [label="No user input\n(fully automatic)", shape=ellipse, fillcolor="#FFFACD"]
        t001_llm [label="No LLM calls", shape=ellipse, fillcolor="#E8E8E8"]

        t001_mem [label="TaskMemory:\nmem.finding(Platform: Linux (hostname))\nmem.finding(Required tools: 5/5 verified)\nmem.finding(Recommended: 3/4 available)\nmem.configuration(Dashboard launched)",
                  shape=note, fillcolor="#DDA0DD"]
    }

    entry -> t001

    // =============================================
    // TASK 002: Provider Detection
    // =============================================

    subgraph cluster_t002 {
        label="Task 002: Provider Detection"
        style=filled
        fillcolor="#F0FFF0"
        color="#228B22"

        t002 [label="task_002_provider_detection.py\n\nSteps:\n1. Detect claude CLI on PATH\n2. Check ANTHROPIC_API_KEY\n3. Check AWS credentials (profile/keys)\n4. Check .env for credentials\n5. Scan Ollama hosts for models\n6. Health-check each provider\n7. Build priority chain\n8. Display provider inventory",
              shape=box, fillcolor="#90EE90"]

        t002_out [label="Artifacts:\nprovider-inventory.json\n(detected providers, health,\ncredentials, model lists)",
                  shape=note, fillcolor="#B0E0B0"]

        t002_user [label="No user input\n(fully automatic)", shape=ellipse, fillcolor="#FFFACD"]

        t002_mem [label="TaskMemory:\nmem.finding(Detected providers: ...)\nmem.finding(Health: N healthy, M unavail)\nmem.decision(Primary chain: claude-code → ...)\nmem.configuration(Credentials: Anthropic, AWS)\nmem.configuration(Ollama: disabled/enabled)",
                  shape=note, fillcolor="#DDA0DD"]
    }

    t001 -> t002

    // =============================================
    // TASK 003: Setup Wizard
    // =============================================

    subgraph cluster_t003 {
        label="Task 003: Setup Wizard"
        style=filled
        fillcolor="#F0FFF0"
        color="#228B22"

        t003 [label="task_003_setup_wizard.py\n\nSteps:\n1. Collect project name, type, description\n2. Select pipeline mode (full/component/skip)\n3. Configure human gates\n4. Set LLM config (provider/model/tier/effort)\n5. Set agent tier and audit profile\n6. Collect technical constraints\n7. Capture all config to project-config.json",
              shape=box, fillcolor="#90EE90"]

        t003_out [label="Artifacts:\nproject-config.json\n(project metadata,\nllm config, pipeline mode,\ngates, constraints)",
                  shape=note, fillcolor="#B0E0B0"]

        t003_user [label="HEAVY user input\nMultiple prompts:\nproject name, type, mode,\nLLM selection, constraints",
                   shape=ellipse, fillcolor="#FFD700", style="filled,bold"]

        t003_mem [label="TaskMemory:\nmem.decision(Project: name — description)\nmem.decision(Type: X | Mode: Y | Skip: Z)\nmem.decision(Human gates: phases 0,2,5,9)\nmem.configuration(LLM: provider/model/effort)\nmem.configuration(Agents: tier | Audits: profile)\nmem.finding(Constraints: N requirements)",
                  shape=note, fillcolor="#DDA0DD"]
    }

    t002 -> t003

    // =============================================
    // TASK 004: Material Scan
    // =============================================

    subgraph cluster_t004 {
        label="Task 004: Material Scan"
        style=filled
        fillcolor="#F0FFF0"
        color="#228B22"

        t004 [label="task_004_material_scan.py\n\nSteps:\n1. Scan project root for source files\n2. Detect languages and frameworks\n3. Count files, lines, documentation\n4. Scan for reference materials\n5. Collect external references\n6. Build material manifest",
              shape=box, fillcolor="#90EE90"]

        t004_out [label="Artifacts:\nmaterial-manifest.json\n(files, lines, languages,\nframeworks, references)\ndocs/reference/ (if external)",
                  shape=note, fillcolor="#B0E0B0"]

        t004_user [label="Minimal input\n(approve reference paths)", shape=ellipse, fillcolor="#FFFACD"]

        t004_mem [label="TaskMemory:\nmem.finding(Scanned: N files, M lines)\nmem.finding(Stack: Python, Rust + ...)\nmem.finding(Docs: X files | Source: Y files)\nmem.finding(External refs: Z from paths)\nmem.decision(Collected N to docs/reference/)",
                  shape=note, fillcolor="#DDA0DD"]
    }

    t003 -> t004

    // =============================================
    // TASK 005: Repository & System Setup
    // =============================================

    subgraph cluster_t005 {
        label="Task 005: Repository & System Setup"
        style=filled
        fillcolor="#F0FFF0"
        color="#228B22"

        t005 [label="task_005_repository_setup.py\n\nSteps:\n1. Count agents from agent-manifest.json\n2. Count audit categories\n3. Count skills\n4. Detect git config (user, branch, remote)\n5. Measure system specs (arch, cores, RAM)\n6. Check network latency\n7. Validate LLM routing\n8. Write env-validation.json",
              shape=box, fillcolor="#90EE90"]

        t005_out [label="Artifacts:\nenv-validation.json\n(agents, audits, skills,\ngit info, system specs,\nrouting validation)",
                  shape=note, fillcolor="#B0E0B0"]

        t005_user [label="No user input\n(fully automatic)", shape=ellipse, fillcolor="#FFFACD"]

        t005_mem [label="TaskMemory:\nmem.finding(Agents: N | Audits: M | Skills: K)\nmem.configuration(Git: user@branch, remote)\nmem.finding(System: arch/cores/RAM)\nmem.finding(Routing: mode configured)",
                  shape=note, fillcolor="#DDA0DD"]
    }

    t004 -> t005

    // =============================================
    // PHASE COMPLETION
    // =============================================

    closeout [label="Phase 0 Closeout\n.outputs/0-setup/closeout.json\n\nGates Phase 1 entry",
              shape=box, fillcolor="#FFD700", style="filled,bold"]

    t005 -> closeout

    // =============================================
    // ARTIFACT SUMMARY
    // =============================================

    subgraph cluster_artifacts {
        label="Phase 0 Artifacts (.outputs/0-setup/)"
        style=dashed
        color="#666666"

        a1 [label="project-config.json", shape=note, fillcolor="#FFFACD"]
        a2 [label="provider-inventory.json", shape=note, fillcolor="#FFFACD"]
        a3 [label="material-manifest.json", shape=note, fillcolor="#FFFACD"]
        a4 [label="env-validation.json", shape=note, fillcolor="#FFFACD"]
        a5 [label="closeout.json", shape=note, fillcolor="#FFFACD"]
    }

    t003 -> a1 [style=dotted, color="#999999"]
    t002 -> a2 [style=dotted, color="#999999"]
    t004 -> a3 [style=dotted, color="#999999"]
    t005 -> a4 [style=dotted, color="#999999"]
    closeout -> a5 [style=dotted, color="#999999"]
}
