// Phase 3: Tasking — Task Flow
// Generated: 2026-03-01 from codebase analysis

digraph phase_03_tasking {
    rankdir=TB
    fontname="Helvetica"
    fontsize=16
    label="Phase 3: Tasking \u2014 PRD Decomposition"
    labelloc=t
    labeljust=c
    pad=0.3
    nodesep=0.35
    ranksep=0.45
    splines=true
    bgcolor=white

    node [fontname="Helvetica", fontsize=10, style="filled,rounded", shape=box, margin="0.12,0.06"]
    edge [fontname="Helvetica", fontsize=8, arrowsize=0.7]

    // ── Input ──
    node [shape=note, fillcolor="#FFFACD", fontsize=8]
    prd [label="docs/prd/PRD.md\n(from Phase 2)"]

    // ── Task spine ──
    node [shape=box]
    t301 [label="301  Entry & Init\nValidate PRD + Phase 2 closeout", fillcolor="#ADD8E6"]
    t302 [label="302  Agent Selection\nAnalyze PRD patterns: API, auth, DB, UI", fillcolor="#ADD8E6"]
    t303 [label="303  Task Decomposition  [opus]\nPer-feature LLM decomposition\nMerge + renumber", fillcolor="#ADD8E6"]
    t304 [label="304  Dependency Analysis\nDAG validation, topological sort\nGenerate parallel work waves", fillcolor="#ADD8E6"]
    t305 [label="305  Phase Audit", fillcolor="#E8E8E8"]
    t306 [label="306  Closeout", fillcolor="#E8E8E8"]
    next [label="Phase 4: Specification  \u2192", fillcolor="#B3D9FF", style="filled,rounded,bold"]

    prd -> t301 -> t302 -> t303 -> t304 -> t305 -> t306 -> next

    // ── Knowledge Graph ──
    node [shape=cylinder, fillcolor="#E8D5F5", fontsize=8]
    kg [label="Knowledge Graph\ntask nodes"]
    t303 -> kg [style=dashed, color="#8B008B", arrowsize=0.5]
    kg -> t304 [style=dashed, color="#8B008B", arrowsize=0.5, label="validate deps"]
    {rank=same; t303; kg}

    // ── Agents ──
    node [shape=component, fillcolor="#E0FFE0", fontsize=8]
    agents [label="task-decomposer [opus]\ndependency-mapper [sonnet]\nwork-packager [sonnet]\ncoverage-checker [haiku]"]
    agents -> t303 [style=dotted, color="#666666", arrowsize=0.5]
    {rank=same; t302; agents}

    // ── Outputs ──
    node [shape=note, fillcolor="#FFFACD", fontsize=8, margin="0.08,0.04"]
    o_tasks [label=".taskmaster/tasks/tasks.json\nid, title, deps, priority"]
    o_waves [label=".taskmaster/reports/\nwork-packages.json\ndependency-graph.json"]

    t303 -> o_tasks [style=dashed, color="#4169E1", arrowsize=0.5]
    t304 -> o_waves [style=dashed, color="#4169E1", arrowsize=0.5]
    {rank=same; t304; o_waves}
}
