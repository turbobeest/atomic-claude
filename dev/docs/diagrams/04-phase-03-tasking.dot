// Phase 3: Tasking — Task Flow
// PRD decomposition into atomic tasks with dependency analysis
// Generated: 2026-03-01 from codebase analysis

digraph phase_03_tasking {
    rankdir=TB
    fontname="Helvetica"
    fontsize=14
    label="Phase 3: Tasking — PRD Decomposition & Dependency Analysis"
    labelloc=t
    pad=0.5
    nodesep=0.5
    ranksep=0.7

    node [fontname="Helvetica", fontsize=10, style=filled, shape=box]
    edge [fontname="Helvetica", fontsize=9]

    // Input
    node [shape=note, fillcolor="#FFFACD"]
    prd [label="docs/prd/PRD.md\n(from Phase 2)"]

    // Tasks
    t301 [label="Task 301\nEntry & Initialization\n─────────────\nValidate PRD + Phase 2 closeout\nInitialize .taskmaster/", fillcolor="#ADD8E6"]
    t302 [label="Task 302\nAgent Selection\n─────────────\nAnalyze PRD patterns:\nAPI, auth, database, UI\nSelect decomposition agents", fillcolor="#ADD8E6"]
    t303 [label="Task 303\nTask Decomposition\n─────────────\nPer-feature LLM decomposition\n(large PRDs split by feature)\nMerge + renumber tasks", fillcolor="#ADD8E6"]
    t304 [label="Task 304\nDependency Analysis\n─────────────\nValidate DAG (cycles, orphans)\nTopological sort → levels\nGenerate work packages\n(parallel waves)", fillcolor="#ADD8E6"]
    t305 [label="Task 305\nPhase Audit", fillcolor="#E8E8E8"]
    t306 [label="Task 306\nCloseout", fillcolor="#E8E8E8"]

    prd -> t301
    t301 -> t302 -> t303 -> t304 -> t305 -> t306

    // LLM
    node [shape=oval, fillcolor="#98FB98"]
    llm_opus [label="opus\nper-feature\ndecomposition"]
    llm_opus -> t303 [style=dashed, color="#228B22"]

    // Outputs
    node [shape=note, fillcolor="#FFFACD"]
    o_tasks [label=".taskmaster/tasks/tasks.json\n─────────────\nid, title, description, status\npriority, category, dependencies\nacceptance_criteria\nestimated_complexity"]
    o_deps [label=".taskmaster/reports/\ndependency-graph.json"]
    o_waves [label=".taskmaster/reports/\nwork-packages.json\n─────────────\nWave 1: [T1,T2,T3] (parallel)\nWave 2: [T4,T5] (parallel)\nWave 3: [T6] (sequential)"]

    t303 -> o_tasks [style=dashed, color="#4169E1"]
    t304 -> o_deps [style=dashed, color="#4169E1"]
    t304 -> o_waves [style=dashed, color="#4169E1"]

    // Knowledge graph
    node [shape=cylinder, fillcolor="#DDA0DD"]
    kg [label="Knowledge Graph\ntask nodes"]
    t303 -> kg [style=dashed, color="#8B008B"]
    kg -> t304 [style=dashed, color="#8B008B", label="validate\ndeps"]

    // Core agents
    node [shape=component, fillcolor="#E0FFE0"]
    agents [label="Core Agents:\ntask-decomposer (opus)\ndependency-mapper (sonnet)\nwork-packager (sonnet)\ntask-validator (sonnet)\ncoverage-checker (haiku)"]
    agents -> t303 [style=dotted, color="#666666"]

    // Next phase
    node [shape=box, fillcolor="#B3D9FF", style="filled,bold"]
    next [label="→ Phase 4: Specification"]
    t306 -> next
}
