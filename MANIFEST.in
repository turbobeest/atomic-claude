# Atomic Claude 2.0 - Distribution Manifest
# Specifies which non-Python files to include in the distribution package

# Documentation
include README.md
include CLAUDE.md
include LICENSE

# Configuration
include .env.example
recursive-include config *.json

# Bash libraries and scripts
recursive-include lib *.sh
recursive-include phases *.sh

# Agent and audit repositories
recursive-include agents *.csv *.json *.md
recursive-include audits *.csv *.json *.md

# Test fixtures
recursive-include test/fixtures *.json *.md *.csv

# Exclude build artifacts
global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store

# Exclude temporary and output directories
prune .outputs
prune .state
prune .logs
prune .test-env
prune test/reports
prune reports

# Exclude git files
exclude .gitignore
exclude .gitattributes
