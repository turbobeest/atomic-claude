{
  "version": "2.0.0",
  "description": "Directories included in runtime sparse-checkout install",
  "cones": {
    "required": [
      "core",
      "phases",
      "orchestration",
      "config",
      "initialization",
      "agents/expert-agents",
      "agents/pipeline-agents",
      "audits/categories",
      "audits/data"
    ],
    "optional": {
      "dashboard": "Real-time monitoring UI (requires Node.js 18+)"
    }
  },
  "excluded_dev_only": [
    "tests",
    "docs",
    "scripts",
    "examples",
    "reports",
    "audits/code-audit-*",
    "audits/schema",
    "audits/docs",
    "audits/scripts"
  ]
}
