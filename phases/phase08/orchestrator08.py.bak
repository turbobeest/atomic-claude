#!/usr/bin/env python3
"""
Phase 8 Orchestrator (orchestrator08.py)

Orchestrator for Phase 8: Deployment Prep - Deployment preparation and artifact generation.

Tasks:
  801 - Entry initialization
  802 - Deployment setup
  803 - Agent selection
  804 - Artifact generation
  805 - Phase audit
  806 - Deployment approval
  807 - Closeout
"""

import sys
import json
from pathlib import Path
from datetime import datetime

# Ensure atomic-claude2 root is in path
sys.path.insert(0, str(Path(__file__).parent.parent.parent))

from core.state import StateManager, task_running
from core.ui import phase_header, phase_complete
from core.subprocess_runner import run_task_script_streaming
from orchestration.pre_task_validation import validate_directory_pristine


def run_phase(resume_at: str = None) -> bool:
    """
    Execute Phase 8: Deployment Prep

    Args:
        resume_at: Optional task ID to resume from (e.g., "804")

    Returns:
        bool: True if phase completed successfully
    """
    phase_header("Phase 8: Deployment Prep")

    state = StateManager()
    phase_id = "8-deployment-prep"

    # Task list in execution order
    tasks = [
        ("801", "Entry initialization", task_801_entry_initialization),
        ("802", "Deployment setup", task_802_deployment_setup),
        ("803", "Agent selection", task_803_agent_selection),
        ("804", "Artifact generation", task_804_artifact_generation),
        ("805", "Phase audit", task_805_phase_audit),
        ("806", "Deployment approval", task_806_deployment_approval),
        ("807", "Closeout", task_807_closeout),
    ]

    # Determine starting point
    start_index = 0
    if resume_at:
        for i, (task_id, _, _) in enumerate(tasks):
            if task_id == resume_at:
                start_index = i
                break

    # Execute tasks
    for task_id, task_name, task_func in tasks[start_index:]:
        # Skip if already completed
        if state.is_task_complete(phase_id, task_id):
            print(f"✓ Task {task_id} already complete, skipping")
            continue

        # PRE-TASK VALIDATION: Ensure directory is pristine (BLOCKER)
        if not validate_directory_pristine(phase_id, task_id):
            print(f"\n🛑 Cannot proceed to Task {task_id} - fix violations first")
            return False

        # Run task
        print(f"\n⚡ Running Task {task_id}: {task_name}")

        try:
            success = task_func()
            if not success:
                print(f"\n❌ Task {task_id} failed")
                return False

            state.mark_task_complete(phase_id, task_id, task_name)

        except Exception as e:
            print(f"\n❌ Task {task_id} error: {e}")
            return False

    phase_complete("Phase 8: Deployment Prep")

    # Create closeout file
    create_closeout(phase_id, tasks)

    return True


# Task implementations (call bash scripts via subprocess)

def task_801_entry_initialization() -> bool:
    """Task 801: Entry initialization"""
    script_path = Path(__file__).parent / "tasks" / "801-entry-initialization.sh"
    exit_code = run_task_script_streaming(script_path, "8-deployment-prep", "801", timeout=300)
    return exit_code == 0


def task_802_deployment_setup() -> bool:
    """Task 802: Deployment setup"""
    script_path = Path(__file__).parent / "tasks" / "802-deployment-setup.sh"
    exit_code = run_task_script_streaming(script_path, "8-deployment-prep", "802", timeout=600)
    return exit_code == 0


def task_803_agent_selection() -> bool:
    """Task 803: Agent selection"""
    script_path = Path(__file__).parent / "tasks" / "803-agent-selection.sh"
    exit_code = run_task_script_streaming(script_path, "8-deployment-prep", "803", timeout=300)
    return exit_code == 0


def task_804_artifact_generation() -> bool:
    """Task 804: Artifact generation"""
    script_path = Path(__file__).parent / "tasks" / "804-artifact-generation.sh"
    exit_code = run_task_script_streaming(script_path, "8-deployment-prep", "804", timeout=1800)
    return exit_code == 0


def task_805_phase_audit() -> bool:
    """Task 805: Phase audit"""
    script_path = Path(__file__).parent / "tasks" / "805-phase-audit.sh"
    exit_code = run_task_script_streaming(script_path, "8-deployment-prep", "805", timeout=300)
    return exit_code == 0


def task_806_deployment_approval() -> bool:
    """Task 806: Deployment approval"""
    script_path = Path(__file__).parent / "tasks" / "806-deployment-approval.sh"
    exit_code = run_task_script_streaming(script_path, "8-deployment-prep", "806", timeout=300)
    return exit_code == 0


def task_807_closeout() -> bool:
    """Task 807: Closeout"""
    script_path = Path(__file__).parent / "tasks" / "807-closeout.sh"
    exit_code = run_task_script_streaming(script_path, "8-deployment-prep", "807", timeout=300)
    return exit_code == 0


def create_closeout(phase_id: str, tasks: list):
    """
    Create phase closeout file.

    Args:
        phase_id: Phase identifier (e.g., "8-deployment-prep")
        tasks: List of (task_id, task_name, task_func) tuples
    """
    from pathlib import Path
    import json
    from datetime import datetime

    # Get atomic-claude2 root
    atomic_root = Path(__file__).parent.parent.parent

    # Closeout file path
    closeout_dir = atomic_root / ".outputs" / phase_id
    closeout_dir.mkdir(parents=True, exist_ok=True)
    closeout_file = closeout_dir / "closeout.json"

    # Build closeout data
    closeout = {
        "phase": phase_id,
        "completed_at": datetime.now().isoformat(),
        "tasks_completed": len(tasks),
        "tasks": [
            {
                "id": task_id,
                "name": task_name,
                "status": "completed"
            }
            for task_id, task_name, _ in tasks
        ],
        "outputs": {
            "deployment_artifacts": "Deployment artifacts generated",
            "deployment_plan": "Deployment plan created",
            "agent_roster": "Selected deployment agents"
        }
    }

    # Write closeout file
    with open(closeout_file, "w") as f:
        json.dump(closeout, f, indent=2)

    print(f"\n✓ Closeout file created: {closeout_file}")


if __name__ == "__main__":
    import sys

    resume_at = None
    if len(sys.argv) > 1:
        resume_at = sys.argv[1]

    success = run_phase(resume_at)
    sys.exit(0 if success else 1)
