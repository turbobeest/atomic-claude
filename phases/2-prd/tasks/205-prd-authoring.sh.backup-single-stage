## Output Instructions

Generate the COMPLETE PRD following the 15-section template above EXACTLY.

- Extract functional requirements (10-25 FRs) from discovery context
- Extract non-functional requirements (5-10 NFRs) from discovery context
- Use RFC 2119 language (SHALL/SHOULD/MAY) for every requirement
- Add OpenSpec WHEN/THEN scenarios for every FR
- Build the Logical Dependency Chain (section 5) as Foundation → Core → Feature → Integration
- Define tech stack explicitly in section 2.1 (no TBD entries)
- Make development phases scope-based, not time-based

Output the PRD document as markdown. Do NOT add any explanatory text before or after the document.
EOF

    atomic_waiting "prd-writer generating 15-section PRD..."

    local saved_turns="${CLAUDE_MAX_TURNS:-1}"
    export CLAUDE_MAX_TURNS=5  # Allow sufficient turns for large document generation

    if atomic_invoke "$prompts_dir/prd-authoring.md" "$prd_file" "PRD generation" --timeout=1800; then
        # Validate PRD has all 15 sections
        local section_count=$(grep -c "^## [0-9]" "$prd_file" 2>/dev/null || echo 0)

        if [[ $section_count -ge 15 ]]; then
            atomic_success "PRD generated with all 15 sections"
        else
            atomic_warn "PRD may be incomplete - found $section_count/15 sections"
        fi
    else
        atomic_error "PRD generation failed - creating fallback template"
        _205_create_fallback_prd "$prd_file"
    fi

    export CLAUDE_MAX_TURNS="$saved_turns"

    echo ""

    # ═══════════════════════════════════════════════════════════════════════════
    # SUMMARY
    # ═══════════════════════════════════════════════════════════════════════════

    echo -e "${DIM}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo -e "  ${BOLD}PRD Created:${NC} $prd_file"
    echo ""

    # Quick preview
    echo -e "  ${DIM}Section headers:${NC}"
    grep -E '^##' "$prd_file" 2>/dev/null | head -16 | while read -r line; do
        echo -e "    $line"
    done
    echo ""

    atomic_context_artifact "prd-document" "$prd_file" "Product Requirements Document"
    atomic_context_decision "PRD authored with 15 sections" "authoring"

    atomic_success "PRD authoring complete"

    return 0
}

