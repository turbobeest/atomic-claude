"""
Task 305: Phase Audit - Task Decomposition

AI-driven audit selection from turbobeest/audits repository.

This task is a wrapper around the audit system, which performs automated
quality checks on the Phase 3 outputs.
"""

import sys
import subprocess
from pathlib import Path
from typing import Optional

# Add project root to path for imports
sys.path.insert(0, str(Path(__file__).parent.parent.parent.parent))

from core.utils.cli_ui import print_red, print_green


def execute(atomic_root: Path, output_dir: Path, uat_mode: bool = False) -> bool:
    """
    Execute Task 305: Phase Audit.

    Args:
        atomic_root: Path to atomic-claude root directory
        output_dir: Path to phase output directory
        uat_mode: If True, bypass interactive prompts for testing

    Returns:
        True if task completed successfully, False otherwise
    """
    # Source the audit library
    audit_lib = atomic_root / "lib" / "audit.sh"

    # Check for library in ATOMIC_LIB_ROOT env var
    import os
    if not audit_lib.exists():
        lib_root = os.environ.get("ATOMIC_LIB_ROOT")
        if lib_root:
            audit_lib = Path(lib_root) / "lib" / "audit.sh"

    if not audit_lib.exists():
        print_red(f"✗ audit.sh not found at {audit_lib}")
        return False

    # Call bash audit wrapper
    # The audit.sh library provides audit_phase_wrapper function
    try:
        env = os.environ.copy()
        env["ATOMIC_ROOT"] = str(atomic_root.parent)
        env["ATOMIC_OUTPUT_DIR"] = str(output_dir.parent)
        env["CURRENT_PHASE"] = "3-tasking"

        if uat_mode:
            env["ATOMIC_UAT_MODE"] = "true"

        # Run audit via bash
        result = subprocess.run(
            ["bash", "-c", f"source {audit_lib} && audit_phase_wrapper 3 'Task Decomposition'"],
            env=env,
            capture_output=False,
            text=True
        )

        if result.returncode == 0:
            print_green("✓ Phase audit complete")
            return True
        else:
            print_red("✗ Phase audit failed")
            return False

    except Exception as e:
        print_red(f"✗ Audit error: {e}")
        return False


if __name__ == "__main__":
    # CLI execution support
    import argparse

    parser = argparse.ArgumentParser(description="Task 305: Phase Audit")
    parser.add_argument('--atomic-root', type=Path, default=Path.cwd(),
                       help='Path to atomic-claude root directory')
    parser.add_argument('--output-dir', type=Path, required=True,
                       help='Path to phase output directory')
    parser.add_argument('--uat-mode', action='store_true',
                       help='Run in UAT mode (skip interactive prompts)')

    args = parser.parse_args()

    success = execute(args.atomic_root, args.output_dir, args.uat_mode)
    sys.exit(0 if success else 1)
