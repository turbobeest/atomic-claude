"""
Task 605: Phase Audit

AI-driven audit selection from audit repository.
"""

import sys
import json
import subprocess
from pathlib import Path
from typing import Dict, Any
from datetime import datetime, timezone

# Add project root to path for imports
sys.path.insert(0, str(Path(__file__).parent.parent.parent.parent))

from core.utils.cli_ui import print_yellow, print_green
from core.utils.file_ops import ensure_dir, write_file


def execute(atomic_root: Path, output_dir: Path, uat_mode: bool = False, mem=None) -> bool:
    """
    Execute Task 605: Phase Audit.

    Args:
        atomic_root: Path to atomic-claude root directory
        output_dir: Path to phase output directory
        uat_mode: If True, bypass interactive prompts for testing

    Returns:
        True if task completed successfully, False otherwise
    """
    # UAT Mode Bypass
    if uat_mode:
        print_yellow("UAT Mode: Creating minimal valid output")

        audit_report = output_dir / "audit-report.json"
        ensure_dir(audit_report.parent)
        write_file(audit_report, json.dumps({
            "audits_run": 0,
            "status": "complete",
            "summary": {
                "passed": 0,
                "failed": 0,
                "warnings": 0
            },
            "overall_status": "PASS",
            "completed_at": datetime.now(timezone.utc).isoformat()
        }, indent=2))

        print_green("✓ UAT bypass complete")
        return True

    # Find audit library
    audit_lib = atomic_root / "lib" / "audit.sh"

    if not audit_lib.exists():
        # Try alternative locations
        lib_root = Path(os.environ.get("ATOMIC_LIB_ROOT", ""))
        if lib_root:
            audit_lib = lib_root / "lib" / "audit.sh"

    if not audit_lib.exists():
        print_yellow("! Audit library not found - skipping audit")
        # Create minimal audit report
        audit_report = output_dir / "audit-report.json"
        ensure_dir(audit_report.parent)
        write_file(audit_report, json.dumps({
            "audits_run": 0,
            "status": "skipped",
            "summary": {
                "passed": 0,
                "failed": 0,
                "warnings": 0
            },
            "overall_status": "SKIP",
            "completed_at": datetime.now(timezone.utc).isoformat()
        }, indent=2))
        return True

    # Execute audit via bash wrapper
    try:
        # Source the audit library and call audit_phase_wrapper
        bash_script = f"""
set -euo pipefail
source "{audit_lib}"
audit_phase_wrapper 6 "Code Review"
"""
        result = subprocess.run(
            ["bash", "-c", bash_script],
            cwd=atomic_root,
            capture_output=True,
            text=True,
            timeout=300
        )

        if result.returncode == 0:
            print_green("✓ Phase audit complete")
            return True
        else:
            print_yellow(f"! Audit completed with warnings: {result.stderr}")
            return True  # Non-blocking

    except subprocess.TimeoutExpired:
        print_yellow("! Audit timed out - continuing")
        return True  # Non-blocking
    except Exception as e:
        print_yellow(f"! Audit error: {e} - continuing")
        return True  # Non-blocking


if __name__ == "__main__":
    # CLI execution support
    import argparse
    import os

    parser = argparse.ArgumentParser(description="Task 605: Phase Audit")
    parser.add_argument('--atomic-root', type=Path, default=Path.cwd(),
                       help='Path to atomic-claude root directory')
    parser.add_argument('--output-dir', type=Path, required=True,
                       help='Path to phase output directory')
    parser.add_argument('--uat-mode', action='store_true',
                       help='Run in UAT mode (skip interactive prompts)')

    args = parser.parse_args()

    success = execute(args.atomic_root, args.output_dir, args.uat_mode)
    sys.exit(0 if success else 1)
