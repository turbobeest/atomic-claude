# State and outputs (regenerated per project)
.state/
.outputs/
.logs/

# Secrets (should never be committed)
.env
.env.*
**/secrets.json
**/*-secrets.json
**/*.key
**/*.pem

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# Tests (run locally, not needed for clone)
tests/
tools/__pycache__/

# Backup files
*.bak
*.backup
*.backup-*

# Temporary status/summary files (root level only)
/*-STATUS.md
/*-SUMMARY.md
/*-SUMMARY.txt
/*-COMPLETE.md
/PHASE*-*.md

# Task state locks
.claude/*.lock
.claude/*.lock.d/
