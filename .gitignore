# CRITICAL: atomic-claude2 is a TOOL, not a project
# ALL project-specific artifacts MUST live in parent directory (../src/, ../docs/, etc.)
# This .gitignore enforces that by ignoring any generated content

# =============================================================================
# ALLOWED: Tool runtime artifacts (these are OK to exist)
# =============================================================================
.outputs/
.state/
.logs/
reports/*
!reports/README.md
!reports/.gitignore

# Dashboard node modules
dashboard/node_modules/
dashboard/package-lock.json
dashboard/dashboard.log

# Agents and Audits repositories (copied from atomic-claude)
# These are needed for pipeline functionality but not tracked
# (they're maintained in the original atomic-claude repo)
# Uncomment below to exclude them from git:
# agents/
# audits/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Testing
.pytest_cache/
.coverage
htmlcov/
coverage.json
.tox/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# =============================================================================
# BLOCKED: Project artifacts (these should NEVER be here)
# =============================================================================

# Generated code - MUST be in ../src/
*.js
*.ts
*.tsx
*.jsx
*.java
*.go
*.rs
*.cpp
*.c
*.h
# EXCEPT tool code in core/, phases/, orchestration/, dashboard/
!core/**/*.py
!phases/**/*.py
!orchestration/**/*.py
!main.py
!dashboard/server.js
!dashboard/public/**/*.js

# Test files - MUST be in ../tests/
*test*.py
*test*.js
*spec*.py
*spec*.js
# EXCEPT tool tests
!tests/**/*

# Documentation - MUST be in ../docs/
*.md
# EXCEPT tool documentation and agent/audit files
!README.md
!docs/**/*.md
!reports/README.md
!agents/**/*.md
!audits/**/*.md

# Data files - MUST be in parent
*.json
*.yaml
*.yml
*.toml
*.xml
# EXCEPT tool config and agent/audit repositories
!config/**/*.yaml
!config/**/*.yml
!dashboard/package.json
!.state/**/*.json
!agents/**/*.json
!audits/**/*.md

# Notebooks, data, etc - SHOULD NEVER BE HERE
*.ipynb
*.csv
*.db
*.sqlite
*.sql
# EXCEPT agent and audit inventory files
!agents/**/*.csv
!audits/**/*.csv

# Compiled binaries - SHOULD NEVER BE HERE
*.exe
*.dll
*.dylib
*.so

# Archives - SHOULD NEVER BE HERE
*.zip
*.tar
*.tar.gz
*.tgz

# =============================================================================
# OS files
# =============================================================================
.DS_Store
Thumbs.db
