# AWS Bedrock Configuration
AWS_PROFILE=bedrock-dev
AWS_REGION=us-gov-west-1
CLAUDE_CODE_USE_BEDROCK=1
ANTHROPIC_MODEL='us-gov.anthropic.claude-sonnet-4-5-20250929-v1:0'

# Network Mode
ATOMIC_NETWORK_MODE=cui

# Tool Development Mode
# Set to "true" when developing atomic-claude2 itself (disables forcing function)
# Set to "false" or unset when using atomic-claude2 to build projects
ATOMIC_TOOL_DEVELOPMENT=true
